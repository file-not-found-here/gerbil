+package org.cloudfoundry.identity.uaa.api;
+
+import org.cloudfoundry.identity.uaa.health.HealthzEndpoint;
+import org.cloudfoundry.identity.uaa.provider.saml.SamlMetadataEndpoint;
+import org.cloudfoundry.identity.uaa.ratelimiting.RateLimitStatusController;
+import org.cloudfoundry.identity.uaa.provider.saml.SignatureAlgorithm;
+import org.cloudfoundry.identity.uaa.zone.beans.IdentityZoneManager;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import org.springframework.security.saml2.provider.service.web.RelyingPartyRegistrationResolver;
+import org.springframework.test.web.servlet.MockMvc;
+
+import javax.sql.DataSource;
+
+import static org.mockito.Mockito.mock;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.setup.MockMvcBuilders.standaloneSetup;
+
+class HttpEndpointSmokeTests {
+
+    @Test
+    void healthEndpointReportsRunningAndAcceptsWildcardProbePaths() throws Exception {
+        DataSource dataSource = mock(DataSource.class);
+        MockMvc mvc = standaloneSetup(new HealthzEndpoint(0, Runtime.getRuntime(), dataSource)).build();
+
+        mvc.perform(get("/healthz"))
+                .andExpect(status().isOk())
+                .andExpect(content().string("UAA running. Database status unknown.\n"));
+        mvc.perform(get("/healthz/database"))
+                .andExpect(status().isOk())
+                .andExpect(content().string("UAA running. Database status unknown.\n"));
+    }
+
+    @Test
+    void samlMetadataRoutesReturnUnauthorizedWhenNoRegistrationCanBeResolved() throws Exception {
+        @SuppressWarnings("unchecked")
+        RelyingPartyRegistrationResolver registrations = mock(RelyingPartyRegistrationResolver.class);
+        SamlMetadataEndpoint endpoint = new SamlMetadataEndpoint(
+                registrations, mock(IdentityZoneManager.class), SignatureAlgorithm.SHA256, false);
+        MockMvc mvc = standaloneSetup(endpoint).build();
+
+        mvc.perform(get("/saml/metadata").accept(MediaType.APPLICATION_XML))
+                .andExpect(status().isUnauthorized());
+        mvc.perform(get("/saml/metadata/tenant").accept(MediaType.APPLICATION_XML))
+                .andExpect(status().isUnauthorized());
+    }
+
+    @Test
+    void rateLimitStatusEndpointReturnsJson() throws Exception {
+        MockMvc mvc = standaloneSetup(new RateLimitStatusController()).build();
+
+        mvc.perform(get("/RateLimitingStatus").accept(MediaType.APPLICATION_JSON))
+                .andExpect(status().isOk())
+                .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON));
+    }
+}
