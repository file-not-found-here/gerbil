+package org.cbioportal.legacy.web;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+class InfoControllerApiTest {
+
+  private MockMvc mockMvc;
+
+  @BeforeEach
+  void setUp() {
+    InfoController controller = new InfoController();
+    ReflectionTestUtils.setField(controller, "portalVersion", "test-portal");
+    ReflectionTestUtils.setField(controller, "dbVersion", "test-db");
+    ReflectionTestUtils.setField(controller, "derivedTableVersion", "test-derived");
+    ReflectionTestUtils.setField(controller, "gitBranch", "test-branch");
+    ReflectionTestUtils.setField(controller, "gitCommitId", "test-commit");
+    ReflectionTestUtils.setField(controller, "gitCommitIdAbbrev", "test-abbrev");
+    ReflectionTestUtils.setField(controller, "gitCommitIdDescribe", "test-describe");
+    ReflectionTestUtils.setField(controller, "gitCommitIdDescribeShort", "test-short");
+    ReflectionTestUtils.setField(controller, "gitCommitMessageFull", "test-full-message");
+    ReflectionTestUtils.setField(controller, "gitCommitMessageShort", "test-message");
+    ReflectionTestUtils.setField(controller, "gitCommitMessageUserEmail", "test@example.org");
+    ReflectionTestUtils.setField(controller, "gitCommitMessageUserName", "Test User");
+    ReflectionTestUtils.setField(controller, "gitDirty", "false");
+    mockMvc = MockMvcBuilders.standaloneSetup(controller).build();
+  }
+
+  @Test
+  void infoEndpointReturnsInstanceMetadataAsJson() throws Exception {
+    mockMvc
+        .perform(get("/api/info"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.portalVersion").value("test-portal"))
+        .andExpect(jsonPath("$.dbVersion").value("test-db"))
+        .andExpect(jsonPath("$.gitCommitId").value("test-commit"))
+        .andExpect(jsonPath("$.gitDirty").value(false));
+  }
+}
