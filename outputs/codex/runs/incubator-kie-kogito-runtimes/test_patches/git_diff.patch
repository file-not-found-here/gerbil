+    @Test
+    void decisionResourceEvaluatesDmnAndServesXmlMetadata() {
+        Response allDecisions = jsonRequest().body(Map.of("a", "2", "b", "3"))
+                .when().post("/basicAdd").then()
+                .statusCode(200).contentType("application/json").extract().response();
+        assertFalse(allDecisions.asString().isBlank(), "Decision evaluation should return a JSON result");
+
+        Response decisionService = jsonRequest().body(Map.of("a", "2", "b", "3"))
+                .when().post("/basicAdd/ds1").then()
+                .statusCode(200).contentType("application/json").extract().response();
+        assertFalse(decisionService.asString().isBlank(), "Decision service evaluation should return a JSON result");
+
+        Response metadata = given().port(port).accept("application/xml").when().get("/basicAdd").then()
+                .statusCode(200).contentType("application/xml").extract().response();
+        assertFalse(metadata.asString().isBlank(), "Decision metadata should return XML");
+    }
+
+    @Test
+    void pmmlRoutesReturnPredictionAndDescriptiveResults() {
+        Map<String, Object> variables = Map.of("temperature", 30, "humidity", 10);
+        Response prediction = jsonRequest().body(variables)
+                .when().post("/PMMLTree/SampleMine").then()
+                .statusCode(200).contentType("application/json").extract().response();
+        assertFalse(prediction.asString().isBlank(), "PMML evaluation should return a JSON prediction");
+
+        Response descriptive = jsonRequest().body(variables)
+                .when().post("/PMMLTree/SampleMine/descriptive").then()
+                .statusCode(200).contentType("application/json").extract().response();
+        assertFalse(descriptive.asString().isBlank(), "Descriptive PMML evaluation should return JSON");
+    }
+
+    @Test
+    void pmmlRoutesRequireJsonRequestBodies() {
+        given().port(port).contentType("text/plain").body("temperature=30&humidity=10")
+                .when().post("/PMMLTree/SampleMine")
+                .then().statusCode(415);
+    }
+}
