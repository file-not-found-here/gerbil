+package org.kie.kogito.process.management;
+
+import java.io.IOException;
+import java.net.InetSocketAddress;
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.util.List;
+import java.util.Set;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.kie.kogito.process.Processes;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.sun.net.httpserver.HttpExchange;
+import com.sun.net.httpserver.HttpServer;
+
+import jakarta.enterprise.inject.Instance;
+import jakarta.ws.rs.core.Response;
+import jakarta.ws.rs.ext.RuntimeDelegate;
+
+import static java.net.HttpURLConnection.HTTP_BAD_REQUEST;
+import static java.net.HttpURLConnection.HTTP_NOT_FOUND;
+import static java.net.HttpURLConnection.HTTP_OK;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class ProcessManagementHttpTest {
+
+    private static final String BASE = "/management/processes";
+    private static final String UNKNOWN_PROCESS = "missing-process";
+    private static final String UNKNOWN_INSTANCE = "missing-instance";
+    private static final Pattern PROCESS_ROUTE = Pattern.compile("/management/processes/([^/]+)(?:/(.*))?");
+
+    private final ObjectMapper mapper = new ObjectMapper();
+    private final HttpClient client = HttpClient.newHttpClient();
+    private HttpServer server;
+    private ExecutorService executor;
+    private String baseUri;
+    private ProcessInstanceManagementResource resource;
+
+    @BeforeEach
+    void startHttpServer() throws IOException {
+        installResponseRuntime();
+        Processes processes = mock(Processes.class);
+        when(processes.processIds()).thenReturn(Set.of());
+        Instance<Processes> processesInstance = mock(Instance.class);
+        when(processesInstance.get()).thenReturn(processes);
+        resource = new ProcessInstanceManagementResource(processesInstance, null);
+
+        server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+        executor = Executors.newSingleThreadExecutor();
+        server.setExecutor(executor);
+        server.createContext(BASE, this::dispatch);
+        server.start();
+        baseUri = "http://127.0.0.1:" + server.getAddress().getPort();
+    }
+
+    private void installResponseRuntime() {
+        RuntimeDelegate delegate = mock(RuntimeDelegate.class);
+        Response.ResponseBuilder builder = mock(Response.ResponseBuilder.class);
+        AtomicInteger status = new AtomicInteger();
+        AtomicReference<Object> entity = new AtomicReference<>();
+        when(delegate.createResponseBuilder()).thenReturn(builder);
+        when(builder.status(anyInt())).thenAnswer(invocation -> {
+            status.set(invocation.getArgument(0));
+            return builder;
+        });
+        when(builder.status(anyInt(), anyString())).thenAnswer(invocation -> {
+            status.set(invocation.getArgument(0));
+            return builder;
+        });
+        when(builder.status(any(Response.StatusType.class))).thenAnswer(invocation -> {
+            status.set(((Response.StatusType) invocation.getArgument(0)).getStatusCode());
+            return builder;
+        });
+        when(builder.entity(any())).thenAnswer(invocation -> {
+            entity.set(invocation.getArgument(0));
+            return builder;
+        });
+        when(builder.entity(any(), any())).thenAnswer(invocation -> {
+            entity.set(invocation.getArgument(0));
+            return builder;
+        });
+        when(builder.build()).thenAnswer(invocation -> {
+            Response response = mock(Response.class);
+            when(response.getStatus()).thenReturn(status.get());
+            when(response.getEntity()).thenReturn(entity.get());
+            return response;
+        });
+        RuntimeDelegate.setInstance(delegate);
+    }
+
+    @AfterEach
+    void stopHttpServer() {
+        server.stop(0);
+        executor.shutdownNow();
+    }
+
+    @Test
+    void processListReturnsJsonOverHttp() throws Exception {
+        HttpResponse<String> response = send("GET", BASE + "/", null);
+        assertThat(response.statusCode()).as(response.body()).isEqualTo(HTTP_OK);
+        assertThat(response.headers().firstValue("Content-Type").orElse("")).startsWith("application/json");
+        assertThat(mapper.readValue(response.body(), List.class)).isEmpty();
+    }
+
+    @Test
+    void processQueriesAndAllInstanceOperationsReturnClientErrorsForUnknownIds() throws Exception {
+        expectClientError("GET", BASE + "/" + UNKNOWN_PROCESS, null);
+        expectClientError("GET", BASE + "/" + UNKNOWN_PROCESS + "/nodes", null);
+
+        String root = BASE + "/" + UNKNOWN_PROCESS + "/instances/" + UNKNOWN_INSTANCE;
+        expectClientError("GET", root + "/error", null);
+        expectClientError("POST", root + "/migrate", "{\"targetProcessId\":\"target\",\"targetProcessVersion\":\"1\"}");
+        expectClientError("POST", BASE + "/" + UNKNOWN_PROCESS + "/migrate", "{\"targetProcessId\":\"target\",\"targetProcessVersion\":\"1\"}");
+        expectClientError("GET", root + "/nodeInstances", null);
+        expectClientError("GET", root + "/timers", null);
+        expectClientError("POST", root + "/retrigger", null);
+        expectClientError("POST", root + "/skip", null);
+        expectClientError("POST", root + "/nodes/node-1", null);
+        expectClientError("POST", root + "/nodeInstances/node-1", null);
+        expectClientError("DELETE", root + "/nodeInstances/node-1", null);
+        expectClientError("GET", root + "/nodeInstances/node-1/timers", null);
+        expectClientError("DELETE", root, null);
+        expectClientError("PATCH", root + "/nodeInstances/node-1/sla", "{\"expirationTime\":\"2030-01-01T00:00:00Z\"}");
+        expectClientError("PATCH", root + "/sla", "{\"expirationTime\":\"2030-01-01T00:00:00Z\"}");
+    }
+
+    private void expectClientError(String method, String path, String body) throws Exception {
+        HttpResponse<String> response = send(method, path, body);
+        assertThat(response.statusCode()).as(response.body()).isIn(HTTP_BAD_REQUEST, HTTP_NOT_FOUND);
+    }
+
+    private HttpResponse<String> send(String method, String path, String body) throws Exception {
+        HttpRequest.Builder builder = HttpRequest.newBuilder(URI.create(baseUri + path)).header("Accept", "application/json");
+        if (body == null) {
+            builder.method(method, HttpRequest.BodyPublishers.noBody());
+        } else {
+            builder.header("Content-Type", "application/json").method(method, HttpRequest.BodyPublishers.ofString(body));
+        }
+        return client.send(builder.build(), HttpResponse.BodyHandlers.ofString());
+    }
+
+    private void dispatch(HttpExchange exchange) throws IOException {
+        try {
+            Response response = invoke(exchange);
+            byte[] bytes = mapper.writeValueAsBytes(response.getEntity());
+            exchange.getResponseHeaders().set("Content-Type", "application/json");
+            exchange.sendResponseHeaders(response.getStatus(), bytes.length);
+            exchange.getResponseBody().write(bytes);
+        } catch (Exception e) {
+            byte[] bytes = e.getMessage().getBytes(StandardCharsets.UTF_8);
+            exchange.sendResponseHeaders(500, bytes.length);
+            exchange.getResponseBody().write(bytes);
+        } finally {
+            exchange.close();
+        }
+    }
+
+    private Response invoke(HttpExchange exchange) throws IOException {
+        String method = exchange.getRequestMethod();
+        String path = exchange.getRequestURI().getPath();
+        if ("GET".equals(method) && (BASE + "/").equals(path)) {
+            return resource.getProcesses();
+        }
+        if ("POST".equals(method) && path.equals(BASE + "/" + UNKNOWN_PROCESS + "/migrate")) {
+            return resource.migrateAllInstances(UNKNOWN_PROCESS, mapper.readValue(exchange.getRequestBody(), ProcessMigrationSpec.class));
+        }
+        Matcher processRoute = PROCESS_ROUTE.matcher(path);
+        if (processRoute.matches()) {
+            String processId = processRoute.group(1);
+            String suffix = processRoute.group(2) == null ? "" : processRoute.group(2);
+            if ("GET".equals(method) && suffix.isEmpty()) {
+                return resource.getProcessInfo(processId);
+            }
+            if ("GET".equals(method) && "nodes".equals(suffix)) {
+                return resource.getProcessNodes(processId);
+            }
+            if (!suffix.startsWith("instances/")) {
+                exchange.sendResponseHeaders(404, -1);
+                return Response.status(HTTP_NOT_FOUND).build();
+            }
+            String[] instancePath = suffix.split("/", 3);
+            if (instancePath.length < 2) {
+                exchange.sendResponseHeaders(404, -1);
+                return Response.status(HTTP_NOT_FOUND).build();
+            }
+            String instanceId = instancePath[1];
+            suffix = instancePath.length == 3 ? instancePath[2] : "";
+            switch (method + " " + suffix) {
+                case "GET error":
+                    return resource.getInstanceInError(processId, instanceId);
+                case "POST migrate":
+                    return resource.migrateInstance(processId, instanceId, new ProcessMigrationSpec());
+                case "GET nodeInstances":
+                    return resource.getWorkItemsInProcessInstance(processId, instanceId);
+                case "GET timers":
+                    return resource.getProcessInstanceTimers(processId, instanceId);
+                case "POST retrigger":
+                    return resource.retriggerInstanceInError(processId, instanceId);
+                case "POST skip":
+                    return resource.skipInstanceInError(processId, instanceId);
+                case "DELETE ":
+                    return resource.cancelProcessInstanceId(processId, instanceId);
+                case "PATCH sla":
+                    return resource.updateProcessInstanceSla(processId, instanceId, new SlaPayload());
+                default:
+                    String[] segments = suffix.split("/");
+                    if (segments.length == 2 && "nodes".equals(segments[0]) && "POST".equals(method)) {
+                        return resource.triggerNodeInstanceId(processId, instanceId, segments[1]);
+                    }
+                    if (segments.length == 2 && "nodeInstances".equals(segments[0])) {
+                        if ("POST".equals(method)) {
+                            return resource.retriggerNodeInstanceId(processId, instanceId, segments[1]);
+                        }
+                        if ("DELETE".equals(method)) {
+                            return resource.cancelNodeInstanceId(processId, instanceId, segments[1]);
+                        }
+                    }
+                    if (segments.length == 3 && "nodeInstances".equals(segments[0]) && "timers".equals(segments[2]) && "GET".equals(method)) {
+                        return resource.getNodeInstanceTimers(processId, instanceId, segments[1]);
+                    }
+                    if (segments.length == 3 && "nodeInstances".equals(segments[0]) && "sla".equals(segments[2]) && "PATCH".equals(method)) {
+                        return resource.updateNodeInstanceSla(processId, instanceId, segments[1], new SlaPayload());
+                    }
+            }
+        }
+        exchange.sendResponseHeaders(404, -1);
+        return Response.status(HTTP_NOT_FOUND).build();
+    }
+}
