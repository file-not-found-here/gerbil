+package org.apache.kylin.rest.controller;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.hamcrest.Matchers.hasSize;
+import static org.hamcrest.Matchers.is;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import java.io.File;
+
+import org.apache.kylin.common.KylinConfig;
+import org.apache.kylin.rest.controller.fixture.FixtureController;
+import org.apache.kylin.rest.request.AlertMessageRequest;
+import org.apache.kylin.rest.service.MonitorService;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.springframework.http.MediaType;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+public class ApiEndpointHttpTest {
+
+    private MockMvc fixtureMvc;
+
+    private MockMvc healthMvc;
+
+    private MockMvc errorMvc;
+
+    private MockMvc configMvc;
+
+    private MockMvc monitorMvc;
+
+    private MockMvc adminMvc;
+
+    private MonitorService monitorService;
+
+    private String previousKylinConf;
+
+    @Before
+    public void setUp() throws Exception {
+        previousKylinConf = System.getProperty(KylinConfig.KYLIN_CONF);
+        System.setProperty(KylinConfig.KYLIN_CONF, new File("../../build/conf").getCanonicalPath());
+        fixtureMvc = MockMvcBuilders.standaloneSetup(new FixtureController()).build();
+        healthMvc = MockMvcBuilders.standaloneSetup(new HealthController()).build();
+        errorMvc = MockMvcBuilders.standaloneSetup(new ErrorController()).build();
+        configMvc = MockMvcBuilders.standaloneSetup(new NConfigController()).build();
+        NMonitorController monitorController = new NMonitorController();
+        monitorService = mock(MonitorService.class);
+        ReflectionTestUtils.setField(monitorController, "monitorService", monitorService);
+        monitorMvc = MockMvcBuilders.standaloneSetup(monitorController).build();
+        adminMvc = MockMvcBuilders.standaloneSetup(new NAdminController()).build();
+    }
+
+    @After
+    public void restoreKylinConf() {
+        if (previousKylinConf == null) {
+            System.clearProperty(KylinConfig.KYLIN_CONF);
+        } else {
+            System.setProperty(KylinConfig.KYLIN_CONF, previousKylinConf);
+        }
+    }
+
+    @Test
+    public void fixtureEndpointReturnsSuccessEnvelope() throws Exception {
+        fixtureMvc.perform(get("/api/handleErrors"))
+                .andExpect(status().isOk()).andExpect(content().string(containsString("000")));
+    }
+
+    @Test
+    public void errorEndpointPropagatesTheStoredFailureAsServerError() throws Exception {
+        errorMvc.perform(get("/api/error/").requestAttr("error", new IllegalStateException("sentinel")))
+                .andExpect(status().isInternalServerError());
+    }
+
+    @Test
+    public void healthInstanceInfoRejectsMissingTokenInEnvelope() throws Exception {
+        healthMvc.perform(post("/api/kg/health/instance_info"))
+                .andExpect(status().isOk()).andExpect(jsonPath("$.code", is("999")))
+                .andExpect(jsonPath("$.msg").value("Check permission failed!"));
+    }
+
+    @Test
+    public void healthStateChangeRejectsMalformedOversizedTokenInEnvelope() throws Exception {
+        byte[] oversizedToken = new byte[65];
+        healthMvc.perform(post("/api/kg/health/instance_service/query_downgrade").content(oversizedToken))
+                .andExpect(status().isOk()).andExpect(jsonPath("$.code", is("999")))
+                .andExpect(jsonPath("$.msg").value("Check permission failed!"));
+    }
+
+    @Test
+    public void configurationEndpointsReturnSuccessfulEnvelopes() throws Exception {
+        configMvc.perform(get("/api/config/is_cloud")).andExpect(status().isOk())
+                .andExpect(jsonPath("$.code", is("000"))).andExpect(jsonPath("$.data").isBoolean());
+
+        configMvc.perform(get("/api/config/all")).andExpect(status().isOk())
+                .andExpect(jsonPath("$.code", is("000"))).andExpect(jsonPath("$.data").isMap());
+    }
+
+    @Test
+    public void deprecatedMonitorMetricsReturnEmptyLists() throws Exception {
+        monitorMvc.perform(get("/api/monitor/memory_info")).andExpect(status().isOk())
+                .andExpect(jsonPath("$.code", is("000"))).andExpect(jsonPath("$.data", hasSize(0)));
+
+        monitorMvc.perform(get("/api/monitor/thread_info")).andExpect(status().isOk())
+                .andExpect(jsonPath("$.code", is("000"))).andExpect(jsonPath("$.data", hasSize(0)));
+    }
+
+    @Test
+    public void adminInstanceInfoReturnsConfiguredTimezone() throws Exception {
+        adminMvc.perform(get("/api/admin/instance_info")).andExpect(status().isOk())
+                .andExpect(jsonPath("$.code", is("000")))
+                .andExpect(jsonPath("$.data['instance.timezone']").isString());
+    }
+
+    @Test
+    public void monitorStatusAndStatisticsReturnSuccessfulEnvelopes() throws Exception {
+        monitorMvc.perform(get("/api/monitor/status")).andExpect(status().isOk())
+                .andExpect(jsonPath("$.code", is("000")));
+
+        monitorMvc.perform(get("/api/monitor/status/statistics").param("start", "1").param("end", "2"))
+                .andExpect(status().isOk()).andExpect(jsonPath("$.code", is("000")));
+    }
+
+    @Test
+    public void monitorStatisticsRejectsMissingAndReversedTimeRanges() throws Exception {
+        monitorMvc.perform(get("/api/monitor/status/statistics").param("start", "1"))
+                .andExpect(status().isBadRequest());
+
+        monitorMvc.perform(get("/api/monitor/status/statistics").param("start", "2").param("end", "1"))
+                .andExpect(status().isInternalServerError());
+    }
+
+    @Test
+    public void validAlertPayloadIsPassedToMonitorService() throws Exception {
+        monitorMvc.perform(post("/api/monitor/alert").contentType(MediaType.APPLICATION_JSON)
+                .content("{\"alerts\":[{\"labels\":{}}]}"))
+                .andExpect(status().isOk());
+
+        verify(monitorService).handleAlertMessage(any(AlertMessageRequest.class));
+    }
+}
