+
+package org.apache.hertzbeat.push.controller;
+
+import org.apache.hertzbeat.push.config.PushErrorRequestWrapper;
+import org.apache.hertzbeat.push.config.PushSuccessRequestWrapper;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import jakarta.servlet.Filter;
+import jakarta.servlet.http.HttpServletRequest;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import static org.hamcrest.Matchers.containsString;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+class PushPrometheusControllerApiTest {
+
+    private MockMvc mvc;
+
+    @BeforeEach
+    void setUp() {
+        Filter pushWrapperFilter = (request, response, chain) -> {
+            HttpServletRequest httpRequest = (HttpServletRequest) request;
+            String mode = httpRequest.getHeader("X-Push-Test-Result");
+            if ("success".equals(mode)) {
+                chain.doFilter(new PushSuccessRequestWrapper(httpRequest, "cpu", "host-1"), response);
+            } else if ("failure".equals(mode)) {
+                chain.doFilter(new PushErrorRequestWrapper(httpRequest, "cpu", "host-1"), response);
+            } else {
+                chain.doFilter(request, response);
+            }
+        };
+        mvc = MockMvcBuilders.standaloneSetup(new PushPrometheusController()).addFilters(pushWrapperFilter).build();
+    }
+
+    @Test
+    void unmatchedPushRequestReturnsBadRequest() throws Exception {
+        mvc.perform(post("/api/push/prometheus/demo/job"))
+                .andExpect(status().isBadRequest())
+                .andExpect(content().string(containsString("not matched")));
+    }
+
+    @Test
+    void successfulPushWrapperReturnsJobAndInstance() throws Exception {
+        mvc.perform(post("/api/push/prometheus/demo/job").header("X-Push-Test-Result", "success"))
+                .andExpect(status().isOk())
+                .andExpect(content().string(containsString("Push success, job: cpu, instance: host-1")));
+    }
+
+    @Test
+    void failedPushWrapperReturnsBadRequestWithJobAndInstance() throws Exception {
+        mvc.perform(post("/api/push/prometheus/demo/job").header("X-Push-Test-Result", "failure"))
+                .andExpect(status().isBadRequest())
+                .andExpect(content().string(containsString("Push failed, job: cpu, instance: host-1")));
+    }
+}
