+public class PublicApiHttpTest {
+
+    private MockMvc mockMvc;
+    private RootRestRepository rootRepository;
+    private ConverterService converter;
+
+    @Before
+    public void setUp() {
+        RootRestResourceController controller = new RootRestResourceController();
+        rootRepository = mock(RootRestRepository.class);
+        converter = mock(ConverterService.class);
+        controller.rootRestRepository = rootRepository;
+        controller.converter = converter;
+        mockMvc = MockMvcBuilders.standaloneSetup(controller).build();
+    }
+
+    @Test
+    public void apiRootReturnsDiscoverableResourceAsJson() throws Exception {
+        RootRest root = new RootRest();
+        RootResource resource = new RootResource(root);
+        when(rootRepository.getRoot(any())).thenReturn(root);
+        when(converter.toResource(root)).thenReturn(resource);
+
+        mockMvc.perform(get("/api"))
+            .andExpect(status().isOk())
+            .andExpect(content().contentTypeCompatibleWith("application/json"));
+
+        verify(rootRepository).getRoot(any());
+        verify(converter).toResource(root);
+    }
