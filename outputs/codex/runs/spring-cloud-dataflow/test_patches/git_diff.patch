+package org.springframework.cloud.dataflow.server.controller;
+
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import org.springframework.cloud.common.security.support.SecurityStateBean;
+import org.springframework.cloud.dataflow.completion.CompletionProposal;
+import org.springframework.cloud.dataflow.completion.StreamCompletionProvider;
+import org.springframework.cloud.dataflow.completion.TaskCompletionProvider;
+import org.springframework.cloud.dataflow.server.controller.security.SecurityController;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import static org.hamcrest.Matchers.is;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.redirectedUrl;
+
+/** HTTP tests for metadata and completion APIs that need no server infrastructure. */
+class DataflowMetadataApiHttpTests {
+
+	@Test
+	void securityInfoReportsAnonymousMode() throws Exception {
+		SecurityStateBean security = mock(SecurityStateBean.class);
+		when(security.isAuthenticationEnabled()).thenReturn(false);
+		MockMvc mvc = MockMvcBuilders.standaloneSetup(new SecurityController(security)).build();
+		mvc.perform(get("/security/info"))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.authenticationEnabled", is(false)));
+	}
+
+	@Test
+	void dashboardAliasesRedirectToTheBundledUi() throws Exception {
+		MockMvc mvc = MockMvcBuilders.standaloneSetup(new UiController()).build();
+		mvc.perform(get("/dashboard")).andExpect(status().is3xxRedirection())
+				.andExpect(redirectedUrl("/dashboard/index.html"));
+		mvc.perform(get("/dashboard/")).andExpect(status().is3xxRedirection())
+				.andExpect(redirectedUrl("/dashboard/index.html"));
+	}
+
+	@Test
+	void completionEndpointsReturnProposalsForTheRequestedPrefix() throws Exception {
+		StreamCompletionProvider streams = mock(StreamCompletionProvider.class);
+		TaskCompletionProvider tasks = mock(TaskCompletionProvider.class);
+		when(streams.complete("str", 2)).thenReturn(List.of(new CompletionProposal("stream", "stream source")));
+		when(tasks.complete("ta", 1)).thenReturn(List.of(new CompletionProposal("task", "task name")));
+		MockMvc mvc = MockMvcBuilders.standaloneSetup(new CompletionController(streams, tasks)).build();
+
+		mvc.perform(get("/completions/stream").param("start", "str").param("detailLevel", "2"))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.proposals[0].text", is("stream")))
+				.andExpect(jsonPath("$.proposals[0].explanation", is("stream source")));
+		mvc.perform(get("/completions/task").param("start", "ta"))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.proposals[0].text", is("task")));
+		verify(streams).complete("str", 2);
+		verify(tasks).complete("ta", 1);
+	}
+}
