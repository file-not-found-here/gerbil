+			new Endpoint(HttpMethod.POST, "/api/release/cancel", 200, "{}"),
+			new Endpoint(HttpMethod.GET, "/api/release/list", 200),
+			new Endpoint(HttpMethod.GET, "/api/release/list/api-test", 200),
+			new Endpoint(HttpMethod.GET, "/api/release/actuator/api-test/app-test/1?endpoint=health", 200),
+			new Endpoint(HttpMethod.POST, "/api/release/actuator/api-test/app-test/1", 200, "{}"),
+			new Endpoint(HttpMethod.GET, "/", 302)
+	);
+
+	private static AnnotationConfigWebApplicationContext context;
+	private static MockMvc mockMvc;
+
+	@BeforeAll
+	static void createMvcContext() {
+		context = new AnnotationConfigWebApplicationContext();
+		context.setServletContext(new MockServletContext());
+		context.register(MvcTestConfiguration.class);
+		context.refresh();
+		mockMvc = MockMvcBuilders.webAppContextSetup(context).build();
+	}
+
+	@AfterAll
+	static void closeMvcContext() {
+		if (context != null) {
+			context.close();
+		}
+	}
+
+	@TestFactory
+	Stream<DynamicTest> everyPackageAndReleaseMappingDispatchesOverMockMvc() {
+		return ENDPOINTS.stream().map(endpoint -> DynamicTest.dynamicTest(
+				endpoint.method + " " + endpoint.path,
+				() -> {
+					MockHttpServletRequestBuilder request = request(endpoint.method, endpoint.path)
+							.accept(MediaType.APPLICATION_JSON);
+					if (endpoint.body != null) {
+						request.contentType(MediaType.APPLICATION_JSON).content(endpoint.body);
+					}
+					int status = mockMvc.perform(request).andReturn().getResponse().getStatus();
+					assertEquals(endpoint.expectedStatus, status,
+							"HTTP response for " + endpoint.method + " " + endpoint.path);
+				}));
+	}
+
+	@Test
+	void routeTableMatchesControllerMappingCount() {
+		assertEquals(27, ENDPOINTS.size());
+		assertEquals(27, context.getBean(RequestMappingHandlerMapping.class).getHandlerMethods().size(),
+				"Update the API endpoint test table and API_ENDPOINT_COVERAGE.md when controller routes change");
+	}
+
+	private record Endpoint(HttpMethod method, String path, int expectedStatus, String body) {
+
+		private Endpoint(HttpMethod method, String path, int expectedStatus) {
+			this(method, path, expectedStatus, null);
+		}
+	}
