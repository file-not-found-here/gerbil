+			HateoasPageableHandlerMethodArgumentResolver pageableResolver =
+					new HateoasPageableHandlerMethodArgumentResolver();
+			resolvers.add(pageableResolver);
+			resolvers.add(new PagedResourcesAssemblerArgumentResolver(pageableResolver));
+			resolvers.add(new PageableHandlerMethodArgumentResolver());
+		}
+	}
+
+	static class ControllerMocksRegistrar implements ImportBeanDefinitionRegistrar {
+
+		@Override
+		public void registerBeanDefinitions(AnnotationMetadata importingClassMetadata, BeanDefinitionRegistry registry) {
+			registerMock(registry, AboutController.class);
+			registerMock(registry, PackageController.class);
+			registerMock(registry, ReleaseController.class);
+			RootBeanDefinition root = new RootBeanDefinition(RootController.class);
+			root.setInstanceSupplier(() -> {
+				RootController mock = mock(RootController.class);
+				when(mock.index()).thenReturn(new org.springframework.web.servlet.view.RedirectView("/api"));
+				return mock;
+			});
+			registry.registerBeanDefinition("mockRootController", root);
+		}
+
+		private static void registerMock(BeanDefinitionRegistry registry, Class<?> controller) {
+			RootBeanDefinition beanDefinition = new RootBeanDefinition(controller);
+			beanDefinition.setInstanceSupplier(() -> mock(controller));
+			registry.registerBeanDefinition("mock" + controller.getSimpleName(), beanDefinition);
+		}
+	}
+}
