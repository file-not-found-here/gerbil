+	@Test
+	void aboutResponseContainsServerAndShellVersions() throws Exception {
+		VersionInfoProperties properties = new VersionInfoProperties();
+		VersionInfoProperties.DependencyStatus dependencyFetch = new VersionInfoProperties.DependencyStatus();
+		dependencyFetch.setEnabled(false);
+		properties.setDependencyFetch(dependencyFetch);
+
+		VersionInfoProperties.DependencyAboutInfo server = new VersionInfoProperties.DependencyAboutInfo();
+		server.setName("Skipper Server");
+		server.setVersion("1.2.3");
+		VersionInfoProperties.DependencyAboutInfo shell = new VersionInfoProperties.DependencyAboutInfo();
+		shell.setName("Skipper Shell");
+		shell.setVersion("1.2.3");
+		VersionInfoProperties.Dependencies dependencies = new VersionInfoProperties.Dependencies();
+		dependencies.setSpringCloudSkipperServer(server);
+		dependencies.setSpringCloudSkipperShell(shell);
+		properties.setDependencies(dependencies);
+
+		MockMvc mockMvc = MockMvcBuilders.standaloneSetup(new AboutController(properties)).build();
+		mockMvc.perform(get("/api/about").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.versionInfo.server.name").value("Skipper Server"))
+				.andExpect(jsonPath("$.versionInfo.server.version").value("1.2.3"))
+				.andExpect(jsonPath("$.versionInfo.shell.name").value("Skipper Shell"));
+	}
