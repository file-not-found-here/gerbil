+					.contentType(MediaType.APPLICATION_JSON)
+					.content("{\"name\":\"my-composed-task\",\"dsl\":\"<aaa: timestamp || bbb: timestamp>\"}"))
+				.andExpect(status().isOk())
+				.andReturn();
+		JsonNode graph = objectMapper.readTree(parsed.getResponse().getContentAsString()).get("graph");
+
+		this.mockMvc.perform(post("/tools/convertTaskGraphToText")
