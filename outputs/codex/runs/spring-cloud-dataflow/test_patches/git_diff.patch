+package org.springframework.cloud.dataflow.server.controller;
+
+import org.junit.jupiter.api.Test;
+
+import org.springframework.beans.factory.ObjectProvider;
+import org.springframework.boot.actuate.info.BuildInfoContributor;
+import org.springframework.boot.actuate.info.GitInfoContributor;
+import org.springframework.cloud.common.security.support.SecurityStateBean;
+import org.springframework.cloud.dataflow.server.config.DataflowMetricsProperties;
+import org.springframework.cloud.dataflow.server.config.VersionInfoProperties;
+import org.springframework.cloud.dataflow.server.config.VersionInfoProperties.Dependencies;
+import org.springframework.cloud.dataflow.server.config.VersionInfoProperties.DependencyAboutInfo;
+import org.springframework.cloud.dataflow.server.config.VersionInfoProperties.DependencyStatus;
+import org.springframework.cloud.dataflow.server.config.features.FeaturesProperties;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import static org.hamcrest.Matchers.is;
+import static org.mockito.Mockito.mock;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+/** HTTP test for Data Flow server metadata endpoint. */
+class DataflowAboutApiHttpTests {
+
+	@Test
+	void aboutReturnsFeaturesVersionsAndSecurityState() throws Exception {
+		FeaturesProperties features = new FeaturesProperties();
+		features.setStreamsEnabled(false);
+		features.setTasksEnabled(false);
+		VersionInfoProperties versionInfo = new VersionInfoProperties();
+		Dependencies dependencies = new Dependencies();
+		dependencies.setSpringCloudDataflowDashboard(dependency("Dashboard"));
+		dependencies.setSpringCloudDataflowImplementation(dependency("Implementation"));
+		dependencies.setSpringCloudDataflowCore(dependency("Core"));
+		dependencies.setSpringCloudDataflowShell(dependency("Shell"));
+		versionInfo.setDependencies(dependencies);
+		versionInfo.setDependencyFetch(new DependencyStatus());
+		SecurityStateBean security = mock(SecurityStateBean.class);
+		MockMvc mvc = MockMvcBuilders.standaloneSetup(new AboutController(null, null, features, versionInfo,
+				security, new DataflowMetricsProperties(), mock(ObjectProvider.class), mock(ObjectProvider.class))).build();
+
+		mvc.perform(get("/about"))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.featureInfo.streamsEnabled", is(false)))
+				.andExpect(jsonPath("$.securityInfo.authenticationEnabled", is(false)))
+				.andExpect(jsonPath("$.versionInfo.core.name", is("Core")));
+	}
+
+	private DependencyAboutInfo dependency(String name) {
+		DependencyAboutInfo dependency = new DependencyAboutInfo();
+		dependency.setName(name);
+		dependency.setVersion("test-version");
+		return dependency;
+	}
+}
