+					.content("{\"name\":\"broken-task\",\"dsl\":\"<aaa: timestamp ||>\"}"))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.errors").isArray())
+				.andExpect(jsonPath("$.errors").isNotEmpty());
+	}
+
+	@Test
+	void parsedGraphCanBeSentBackToConvertEndpoint() throws Exception {
