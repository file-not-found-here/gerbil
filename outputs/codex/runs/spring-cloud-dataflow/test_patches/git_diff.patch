+	@Test
+	void taskValidationReturnsDefinitionAndAppStatuses() throws Exception {
+		TaskValidationService service = mock(TaskValidationService.class);
+		ValidationStatus result = new ValidationStatus("sample", "step", "validated");
+		result.getAppsStatuses().put("step", "valid");
+		when(service.validateTask("sample")).thenReturn(result);
+		MockMvc mvc = MockMvcBuilders.standaloneSetup(new TaskValidationController(service)).build();
+		mvc.perform(get("/tasks/validation/sample"))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.appName", is("sample")))
+				.andExpect(jsonPath("$.appStatuses.step", is("valid")));
+	}
+
+	@Test
+	void streamValidationReturnsDefinitionAndAppStatuses() throws Exception {
+		StreamService service = mock(StreamService.class);
+		ValidationStatus result = new ValidationStatus("sample", "source | sink", "validated");
+		result.getAppsStatuses().put("source", "valid");
+		when(service.validateStream("sample")).thenReturn(result);
+		MockMvc mvc = MockMvcBuilders.standaloneSetup(new StreamValidationController(service)).build();
+		mvc.perform(get("/streams/validation/sample"))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.appName", is("sample")))
+				.andExpect(jsonPath("$.appStatuses.source", is("valid")));
+	}
+}
