+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.request;
+
+/**
+ * HTTP dispatch smoke coverage for every Data Flow server-core controller mapping.
+ * Controllers are mocked so the test verifies Spring MVC route, method, parameter,
+ * body binding, and declared status wiring without requiring a database or deployer.
+ */
+class ApiEndpointMappingTests {
+
+	private static final Class<?>[] CONTROLLERS = {
+			AboutController.class,
+			AppRegistryController.class,
+			AuditRecordController.class,
+			CompletionController.class,
+			JobExecutionController.class,
+			JobExecutionThinController.class,
+			JobInstanceController.class,
+			JobStepExecutionController.class,
+			JobStepExecutionProgressController.class,
+			RootController.class,
+			RuntimeAppInstanceController.class,
+			RuntimeAppsController.class,
+			RuntimeStreamsController.class,
+			StreamDefinitionController.class,
+			StreamDeploymentController.class,
+			StreamLogsController.class,
+			StreamValidationController.class,
+			TaskCtrController.class,
+			TaskDefinitionController.class,
+			TaskExecutionController.class,
+			TaskExecutionThinController.class,
+			TaskLogsController.class,
+			TaskPlatformController.class,
+			TaskSchedulerController.class,
+			TasksInfoController.class,
+			ToolsController.class,
+			UiController.class,
+			org.springframework.cloud.dataflow.server.TaskValidationController.class,
+			org.springframework.cloud.dataflow.server.controller.security.SecurityController.class
+	};
+
+	private static AnnotationConfigWebApplicationContext context;
+	private static MockMvc mockMvc;
+	private static List<EndpointCase> endpointCases;
+
+	@BeforeAll
+	static void createMvcContext() {
+		context = new AnnotationConfigWebApplicationContext();
+		context.setServletContext(new MockServletContext());
+		context.register(MvcTestConfiguration.class);
+		context.refresh();
+		mockMvc = MockMvcBuilders.webAppContextSetup(context).build();
+		endpointCases = discoverEndpoints(context.getBean(RequestMappingHandlerMapping.class));
+	}
+
+	@AfterAll
+	static void closeMvcContext() {
+		if (context != null) {
+			context.close();
+		}
+	}
+
+	@TestFactory
+	Stream<DynamicTest> everyControllerMappingDispatchesOverMockMvc() {
+		return endpointCases.stream().map(endpoint -> DynamicTest.dynamicTest(
+				endpoint.httpMethod + " " + endpoint.path + " -> " + endpoint.handler.getMethod().getName(),
+				() -> {
+					MockHttpServletRequestBuilder request = request(endpoint.httpMethod, endpoint.path)
+							.accept(MediaType.APPLICATION_JSON);
+					for (Map.Entry<String, String> parameter : endpoint.parameters.entrySet()) {
+						request.param(parameter.getKey(), parameter.getValue());
+					}
+					for (Map.Entry<String, String> header : endpoint.headers.entrySet()) {
+						request.header(header.getKey(), header.getValue());
+					}
+					if (endpoint.contentType != null) {
+						request.contentType(endpoint.contentType);
+					}
+					if (endpoint.body != null) {
+						if (endpoint.contentType == null) {
+							request.contentType(MediaType.APPLICATION_JSON);
+						}
+						request.content(endpoint.body);
+					}
+					org.springframework.test.web.servlet.MvcResult result = mockMvc.perform(request).andReturn();
+					int status = result.getResponse().getStatus();
+					assertTrue(status >= 200 && status < 400,
+							() -> endpoint.httpMethod + " " + endpoint.path + " returned HTTP " + status
+									+ " with exception " + result.getResolvedException());
+					assertEquals(endpoint.expectedStatus, status,
+							"Declared response status for " + endpoint.httpMethod + " " + endpoint.path);
+				}));
+	}
+
+	@Test
+	void discoveredRouteCountMatchesCoverageInventory() {
+		assertEquals(95, endpointCases.size(), "Update API_ENDPOINT_COVERAGE.md when controller routes change");
+	}
+
+	private static List<EndpointCase> discoverEndpoints(RequestMappingHandlerMapping mappings) {
+		List<EndpointCase> cases = new ArrayList<>();
+		for (Map.Entry<RequestMappingInfo, HandlerMethod> entry : mappings.getHandlerMethods().entrySet()) {
+			RequestMappingInfo mapping = entry.getKey();
+			HandlerMethod handler = entry.getValue();
+			Set<String> paths = mapping.getPatternValues();
+			Set<org.springframework.web.bind.annotation.RequestMethod> declaredMethods =
+					mapping.getMethodsCondition().getMethods();
+			List<HttpMethod> methods = declaredMethods.isEmpty() ? List.of(HttpMethod.GET) : declaredMethods.stream()
+					.map(method -> HttpMethod.valueOf(method.name())).toList();
+			MediaType consumes = mapping.getConsumesCondition().getConsumableMediaTypes().stream()
+					.findFirst().orElse(null);
+			for (String pattern : paths) {
+				String path = concretePath(pattern);
+				for (HttpMethod method : methods) {
+					for (String parameterized : mappingParameters(mapping)) {
+						EndpointCase endpoint = new EndpointCase(method, path, handler);
+						endpoint.parameters.putAll(requestParameters(handler.getMethod()));
+						endpoint.parameters.putAll(parseParameters(parameterized));
+						endpoint.headers.putAll(requestHeaders(handler.getMethod()));
+						endpoint.contentType = consumes;
+						endpoint.body = requestBody(handler.getMethod());
+						endpoint.expectedStatus = declaredStatus(handler.getMethod());
+						cases.add(endpoint);
+					}
+				}
+			}
+		}
+		cases.sort(Comparator.comparing((EndpointCase endpoint) -> endpoint.path)
+				.thenComparing(endpoint -> endpoint.httpMethod.name()));
+		return cases;
+	}
+
+	private static List<String> mappingParameters(RequestMappingInfo mapping) {
+		List<String> alternatives = new ArrayList<>();
+		alternatives.add("");
+		for (Object expression : mapping.getParamsCondition().getExpressions()) {
+			String text = expression.toString();
+			if (text.startsWith("!")) {
+				continue;
+			}
+			String[] pair = text.split("=", 2);
+			String name = pair[0];
+			String value = pair.length == 2 ? pair[1] : sample(name);
+			for (int i = 0; i < alternatives.size(); i++) {
+				alternatives.set(i, alternatives.get(i) + "\n" + name + "=" + value);
+			}
+		}
+		return alternatives;
+	}
+
+	private static Map<String, String> parseParameters(String parameters) {
+		java.util.LinkedHashMap<String, String> result = new java.util.LinkedHashMap<>();
+		for (String parameter : parameters.split("\n")) {
+			if (!parameter.isBlank()) {
+				String[] pair = parameter.split("=", 2);
+				result.put(pair[0], pair.length == 2 ? pair[1] : "test");
+			}
+		}
+		return result;
+	}
+
+	private static Map<String, String> requestParameters(Method method) {
+		java.util.LinkedHashMap<String, String> result = new java.util.LinkedHashMap<>();
+		for (Parameter parameter : method.getParameters()) {
+			RequestParam annotation = parameter.getAnnotation(RequestParam.class);
+			if (annotation == null || parameter.getType().equals(Map.class)) {
+				continue;
+			}
+			String name = annotation.name().isEmpty() ? annotation.value() : annotation.name();
+			if (name.isEmpty()) {
+				name = parameter.getName();
+			}
+			if (!name.isEmpty()) {
+				result.put(name, sample(name, parameter.getType()));
+			}
+		}
+		return result;
+	}
+
+	private static Map<String, String> requestHeaders(Method method) {
+		java.util.LinkedHashMap<String, String> result = new java.util.LinkedHashMap<>();
+		for (Parameter parameter : method.getParameters()) {
+			RequestHeader annotation = parameter.getAnnotation(RequestHeader.class);
+			if (annotation != null) {
+				String name = annotation.name().isEmpty() ? annotation.value() : annotation.name();
+				if (!name.isEmpty()) {
+					result.put(name, "test");
+				}
+			}
+			CookieValue cookie = parameter.getAnnotation(CookieValue.class);
+			if (cookie != null) {
+				String name = cookie.name().isEmpty() ? cookie.value() : cookie.name();
+				if (!name.isEmpty()) {
+					result.put("Cookie", name + "=test");
+				}
+			}
+		}
+		return result;
+	}
+
+	private static String requestBody(Method method) {
+		for (Parameter parameter : method.getParameters()) {
+			if (parameter.isAnnotationPresent(RequestBody.class)) {
+				Class<?> type = parameter.getType();
+				if (type.equals(String.class)) {
+					return "\"test\"";
+				}
+			if (type.isArray() || Collection.class.isAssignableFrom(type)) {
+					return "[]";
+				}
+			if (type.equals(Boolean.class) || type.equals(boolean.class)) {
+					return "true";
+			}
+			if (Number.class.isAssignableFrom(type) || type.isPrimitive()) {
+				return "1";
+			}
+			return "{}";
+			}
+		}
+		return null;
+	}
+
+	private static int declaredStatus(Method method) {
+		if (method.getDeclaringClass().equals(UiController.class)) {
+			return 302;
+		}
+		org.springframework.web.bind.annotation.ResponseStatus status =
+				org.springframework.core.annotation.AnnotatedElementUtils.findMergedAnnotation(method,
+						org.springframework.web.bind.annotation.ResponseStatus.class);
+		return status == null ? 200 : status.code().value();
+	}
+
+	private static String concretePath(String pattern) {
+		Matcher matcher = Pattern.compile("\\{([^{}]+)}").matcher(pattern);
+		StringBuffer concrete = new StringBuffer();
+		while (matcher.find()) {
+			String variable = matcher.group(1).split(":", 2)[0];
+			matcher.appendReplacement(concrete, Matcher.quoteReplacement("/" + sample(variable)));
+		}
+		matcher.appendTail(concrete);
+		return concrete.toString().replace("//", "/");
+	}
+
+	private static String sample(String name) {
+		if (name.toLowerCase().contains("date")) {
+			return "2020-01-01T00:00:00,000";
+		}
+		if (name.equals("type")) {
+			return "task";
+		}
+		if (name.equals("id") || name.toLowerCase().endsWith("id") || name.equals("count")
+				|| name.equals("version")) {
+			return "1";
+		}
+		return "api-test";
+	}
+
+	private static String sample(String name, Class<?> type) {
+		if (type.equals(boolean.class) || type.equals(Boolean.class)) {
+			return "true";
+		}
+		if (type.equals(int.class) || type.equals(Integer.class) || type.equals(long.class)
+				|| type.equals(Long.class) || type.equals(short.class) || type.equals(Short.class)) {
+			return "1";
+		}
+		if (type.isArray()) {
+			return sample(name, type.getComponentType());
+		}
+		if (type.isEnum()) {
+			Object[] values = type.getEnumConstants();
+			return values.length == 0 ? "" : values[0].toString();
+		}
+		return sample(name);
+	}
+
+	private static final class EndpointCase {
+
+		private final HttpMethod httpMethod;
+		private final String path;
+		private final HandlerMethod handler;
+		private final java.util.LinkedHashMap<String, String> parameters = new java.util.LinkedHashMap<>();
+		private final java.util.LinkedHashMap<String, String> headers = new java.util.LinkedHashMap<>();
+		private MediaType contentType;
+		private String body;
+		private int expectedStatus;
+
+		private EndpointCase(HttpMethod httpMethod, String path, HandlerMethod handler) {
+			this.httpMethod = httpMethod;
+			this.path = path;
+			this.handler = handler;
+		}
+	}
+
+	@Configuration
+	@EnableWebMvc
+	@Import(ControllerMocksRegistrar.class)
+	static class MvcTestConfiguration implements WebMvcConfigurer {
+
+		@Override
+		public void addArgumentResolvers(List<org.springframework.web.method.support.HandlerMethodArgumentResolver> resolvers) {
+			HateoasPageableHandlerMethodArgumentResolver pageableResolver =
+					new HateoasPageableHandlerMethodArgumentResolver();
+			resolvers.add(pageableResolver);
+			resolvers.add(new PagedResourcesAssemblerArgumentResolver(pageableResolver));
+			resolvers.add(new PageableHandlerMethodArgumentResolver());
+		}
+	}
+
+	static class ControllerMocksRegistrar implements ImportBeanDefinitionRegistrar {
+
+		@Override
+		public void registerBeanDefinitions(AnnotationMetadata importingClassMetadata, BeanDefinitionRegistry registry) {
+			for (Class<?> controller : CONTROLLERS) {
+				RootBeanDefinition beanDefinition = new RootBeanDefinition(controller);
+				beanDefinition.setInstanceSupplier(() -> {
+					Object controllerMock = mock(controller);
+					if (controller.equals(UiController.class)) {
+						when(((UiController) controllerMock).index()).thenReturn("redirect:/dashboard/index.html");
+					}
+					return controllerMock;
+				});
+				registry.registerBeanDefinition("mock" + controller.getSimpleName(), beanDefinition);
+			}
+		}
+	}
+}
