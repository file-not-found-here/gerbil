+package org.springframework.cloud.dataflow.server.controller;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.junit.jupiter.api.Test;
+
+import org.springframework.cloud.dataflow.server.controller.ToolsController;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import static org.hamcrest.Matchers.hasSize;
+import static org.hamcrest.Matchers.empty;
+import static org.hamcrest.Matchers.notNullValue;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultHandlers.print;
+
+/** HTTP-level tests for Data Flow task graph tooling endpoints. */
+class DataflowApiHttpTests {
+
+	private final MockMvc mockMvc = MockMvcBuilders.standaloneSetup(new ToolsController()).build();
+
+	@Test
+	void parseTaskTextReturnsGraphForValidSequence() throws Exception {
+		this.mockMvc.perform(post("/tools/parseTaskTextToGraph")
+					.contentType("application/json")
+						.content("{\"name\":\"sample\",\"dsl\":\"one && two\"}"))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.graph", notNullValue()))
+				.andExpect(jsonPath("$.errors", empty()));
+	}
+
+	@Test
+	void parsedGraphCanBeConvertedBackToTaskText() throws Exception {
+		MvcResult parsed = this.mockMvc.perform(post("/tools/parseTaskTextToGraph")
+					.contentType("application/json")
+					.content("{\"name\":\"sample\",\"dsl\":\"one && two\"}"))
+				.andExpect(status().isOk())
+				.andReturn();
+		JsonNode graph = new ObjectMapper().readTree(parsed.getResponse().getContentAsString()).get("graph");
+		this.mockMvc.perform(post("/tools/convertTaskGraphToText")
+					.contentType("application/json").content(graph.toString()))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.dsl", org.hamcrest.Matchers.is("one && two")))
+				.andExpect(jsonPath("$.errors", empty()));
+	}
+
+	@Test
+	void parseTaskTextReturnsErrorsForInvalidDsl() throws Exception {
+		this.mockMvc.perform(post("/tools/parseTaskTextToGraph")
+					.contentType("application/json").content("{\"name\":\"sample\",\"dsl\":\"not valid dsl @@@\"}"))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.errors", hasSize(1)));
+	}
+}
