+package org.apache.dolphinscheduler.api.controller;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.delete;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.apache.dolphinscheduler.api.interceptor.LoginHandlerInterceptor;
+import org.apache.dolphinscheduler.api.security.Authenticator;
+import org.apache.dolphinscheduler.dao.mapper.UserMapper;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+/** HTTP dispatch coverage for the API route inventory, with real login interception. */
+class ApiEndpointHttpSmokeTest {
+
+    private static final Pattern ENDPOINT = Pattern.compile("^- \\[.\\] (GET|POST|PUT|DELETE|PATCH) (\\S+) - .+$");
+    private static final Pattern SECTION = Pattern.compile("^## ([^ ]+) - ([A-Za-z0-9]+)$");
+
+    @Test
+    void everyProtectedEndpointRejectsAnAnonymousHttpRequest() throws Exception {
+        Map<Class<?>, List<Endpoint>> byController = readInventory();
+        int checked = 0;
+        for (Map.Entry<Class<?>, List<Endpoint>> entry : byController.entrySet()) {
+            if (entry.getKey() == LoginController.class || entry.getKey() == DsErrorController.class) {
+                continue;
+            }
+            Object controller = entry.getKey().getDeclaredConstructor().newInstance();
+            MockMvc mvc = MockMvcBuilders.standaloneSetup(controller)
+                    .addInterceptors(anonymousInterceptor())
+                    .build();
+            for (Endpoint endpoint : entry.getValue()) {
+                if (endpoint.path.endsWith("/users/register")) {
+                    continue; // This public registration route is explicitly excluded by AppConfiguration.
+                }
+                MvcResult result = mvc.perform(request(endpoint)
+                        .contentType(org.springframework.http.MediaType.APPLICATION_JSON))
+                        .andReturn();
+                assertEquals(401, result.getResponse().getStatus(), endpoint.toString());
+                checked++;
+            }
+        }
+        assertEquals(290, checked, "Every secured route in the inventory must reject anonymous requests");
+    }
+
+    @Test
+    void publicLoginRoutesDispatchAndValidateInputs() throws Exception {
+        LoginController controller = new LoginController();
+        Authenticator authenticator = mock(Authenticator.class);
+        ReflectionTestUtils.setField(controller, "authenticator", authenticator);
+        MockMvc mvc = MockMvcBuilders.standaloneSetup(controller).build();
+
+        mvc.perform(post("/login"))
+                .andExpect(status().isBadRequest());
+        mvc.perform(get("/login/sso"))
+                .andExpect(status().isOk());
+        mvc.perform(get("/oauth2-provider"))
+                .andExpect(status().isOk());
+        mvc.perform(get("/redirect/login/oauth2"))
+                .andExpect(status().isBadRequest());
+        MockMvc userMvc = MockMvcBuilders.standaloneSetup(new UsersController()).build();
+        userMvc.perform(post("/users/register"))
+                .andExpect(status().isBadRequest());
+        mvc.perform(delete("/cookies").cookie(new javax.servlet.http.Cookie("sessionId", "test")))
+                .andExpect(status().isOk());
+
+        // The sign-out handler is intentionally protected, even though its sibling login URLs are public.
+        LoginHandlerInterceptor interceptor = anonymousInterceptor();
+        MockMvc secured = MockMvcBuilders.standaloneSetup(controller).addInterceptors(interceptor).build();
+        secured.perform(post("/signOut")).andExpect(status().isUnauthorized());
+    }
+
+    @Test
+    void errorRouteForwardsNotFoundToTheUi() throws Exception {
+        MockMvc mvc = MockMvcBuilders.standaloneSetup(new DsErrorController()).build();
+        MvcResult result = mvc.perform(get("/error").requestAttr("javax.servlet.error.status_code", 404))
+                .andReturn();
+        assertEquals(200, result.getResponse().getStatus());
+        assertTrue(result.getModelAndView().getViewName().contains("ui/index.html"));
+    }
+
+    private LoginHandlerInterceptor anonymousInterceptor() {
+        LoginHandlerInterceptor interceptor = new LoginHandlerInterceptor();
+        Authenticator authenticator = mock(Authenticator.class);
+        when(authenticator.getAuthUser(org.mockito.ArgumentMatchers.any())).thenReturn(null);
+        ReflectionTestUtils.setField(interceptor, "authenticator", authenticator);
+        ReflectionTestUtils.setField(interceptor, "userMapper", mock(UserMapper.class));
+        return interceptor;
+    }
+
+    private org.springframework.test.web.servlet.request.MockHttpServletRequestBuilder request(Endpoint endpoint) {
+        String path = endpoint.path.replace("/dolphinscheduler", "");
+        Matcher matcher = Pattern.compile("\\{[^/]+}").matcher(path);
+        StringBuffer concrete = new StringBuffer();
+        int value = 1;
+        while (matcher.find()) {
+            matcher.appendReplacement(concrete, Integer.toString(value++));
+        }
+        matcher.appendTail(concrete);
+        switch (endpoint.method) {
+            case "POST":
+                return post(concrete.toString());
+            case "PUT":
+                return org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put(concrete.toString());
+            case "DELETE":
+                return delete(concrete.toString());
+            case "PATCH":
+                return org.springframework.test.web.servlet.request.MockMvcRequestBuilders.patch(concrete.toString());
+            default:
+                return get(concrete.toString());
+        }
+    }
+
+    private Map<Class<?>, List<Endpoint>> readInventory() throws IOException, ClassNotFoundException {
+        Path inventory = Path.of("").toAbsolutePath();
+        while (inventory != null && !Files.exists(inventory.resolve("API_ENDPOINT_COVERAGE.md"))) {
+            inventory = inventory.getParent();
+        }
+        if (inventory == null) {
+            throw new IllegalStateException(
+                    "Could not locate API_ENDPOINT_COVERAGE.md from the test working directory");
+        }
+
+        Map<Class<?>, List<Endpoint>> result = new LinkedHashMap<>();
+        Class<?> current = null;
+        for (String line : Files.readAllLines(inventory.resolve("API_ENDPOINT_COVERAGE.md"))) {
+            Matcher section = SECTION.matcher(line);
+            if (section.matches()) {
+                current = Class.forName(section.group(1).replace('/', '.') + "." + section.group(2));
+                result.computeIfAbsent(current, ignored -> new ArrayList<>());
+                continue;
+            }
+            Matcher endpoint = ENDPOINT.matcher(line);
+            if (endpoint.matches()) {
+                if (current == null) {
+                    throw new IllegalStateException("Endpoint appeared before a controller section: " + line);
+                }
+                result.get(current).add(new Endpoint(endpoint.group(1), endpoint.group(2)));
+            }
+        }
+        assertNotEquals(0, result.size(), "The durable endpoint inventory must not be empty");
+        assertEquals(298, result.values().stream().mapToInt(List::size).sum(),
+                "Keep the durable route inventory complete");
+        return result;
+    }
+
+    private static final class Endpoint {
+
+        private final String method;
+        private final String path;
+
+        private Endpoint(String method, String path) {
+            this.method = method;
+            this.path = path;
+        }
+
+        @Override
+        public String toString() {
+            return method + " " + path;
+        }
+    }
+}
