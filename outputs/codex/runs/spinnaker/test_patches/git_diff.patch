@@ -0,0 +1,89 @@
+package com.netflix.spinnaker.clouddriver.controllers;
+
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.netflix.spinnaker.clouddriver.model.CloudMetricDescriptor;
+import com.netflix.spinnaker.clouddriver.model.CloudMetricProvider;
+import com.netflix.spinnaker.clouddriver.model.CloudMetricStatistics;
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+class CloudMetricControllerApiTest {
+  @Test
+  void listsDescriptorsAndForwardsFilters() throws Exception {
+    @SuppressWarnings("unchecked")
+    CloudMetricProvider<CloudMetricDescriptor> provider = mock(CloudMetricProvider.class);
+    when(provider.getCloudProvider()).thenReturn("test");
+    when(provider.findMetricDescriptors("account", "region", Map.of("namespace", "demo")))
+        .thenReturn(List.of(new Descriptor("Requests")));
+
+    MockMvcBuilders.standaloneSetup(new CloudMetricController(List.of(provider)))
+        .build()
+        .perform(get("/cloudMetrics/test/account/region")
+            .accept(MediaType.APPLICATION_JSON)
+            .param("namespace", "demo"))
+        .andExpect(status().isOk())
+        .andExpect(content().json("[{\"name\":\"Requests\"}]"));
+
+    verify(provider).findMetricDescriptors("account", "region", Map.of("namespace", "demo"));
+  }
+
+  @Test
+  void statisticsExcludeTimeBoundsFromFiltersAndUseSuppliedBounds() throws Exception {
+    @SuppressWarnings("unchecked")
+    CloudMetricProvider<CloudMetricDescriptor> provider = mock(CloudMetricProvider.class);
+    when(provider.getCloudProvider()).thenReturn("test");
+    CloudMetricStatistics<?> statistics = new Statistics();
+    when(provider.getStatistics("account", "region", "Requests", Map.of("queue", "main"), 10L, 20L))
+        .thenReturn(statistics);
+    Clock fixedClock = Clock.fixed(Instant.ofEpochMilli(100), ZoneOffset.UTC);
+
+    MockMvcBuilders.standaloneSetup(new CloudMetricController(List.of(provider), fixedClock))
+        .build()
+        .perform(get("/cloudMetrics/test/account/region/Requests/statistics")
+            .accept(MediaType.APPLICATION_JSON)
+            .param("queue", "main")
+            .param("startTime", "10")
+            .param("endTime", "20"))
+        .andExpect(status().isOk())
+        .andExpect(content().json("{\"unit\":\"Count\",\"datapoints\":[]}"));
+
+    verify(provider).getStatistics("account", "region", "Requests", Map.of("queue", "main"), 10L, 20L);
+  }
+
+  private static class Descriptor implements CloudMetricDescriptor {
+    private final String name;
+
+    Descriptor(String name) {
+      this.name = name;
+    }
+
+    @Override
+    public String getName() {
+      return name;
+    }
+  }
+
+  private static class Statistics implements CloudMetricStatistics {
+    @Override
+    public String getUnit() {
+      return "Count";
+    }
+
+    @Override
+    public List getDatapoints() {
+      return List.of();
+    }
+  }
+}
