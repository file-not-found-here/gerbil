+    return mvc(service, provider, null);
+  }
+
+  private static org.springframework.test.web.servlet.MockMvc mvc(
+      AccountDefinitionService service,
+      AccountCredentialsProvider provider,
+      Object advice) {
+    ObjectMapper mapper = new ObjectMapper();
+    SimpleModule module = new SimpleModule();
+    module.addAbstractTypeMapping(CredentialsDefinition.class, TestDefinition.class);
+    mapper.registerModule(module);
+    var builder = org.springframework.test.web.servlet.setup.MockMvcBuilders
+        .standaloneSetup(new CredentialsController(
+            Optional.of(service), new CredentialsConfiguration(), mapper, provider))
+        .setMessageConverters(new MappingJackson2HttpMessageConverter(mapper));
+    if (advice != null) {
+      builder.setControllerAdvice(advice);
+    }
+    return builder.build();
+  }
