+    when(credentials.getRequiredOneBy(null, AccountCredentials.Type.OBJECT_STORE))
+        .thenReturn(objectAccount);
+    StorageServiceRepository storageServices = mock(StorageServiceRepository.class);
+    StorageService storage = mock(StorageService.class);
+    when(storageServices.getRequiredOne("config-store")).thenReturn(storage);
+    when(storageServices.getRequiredOne("object-store")).thenReturn(storage);
+    CanaryConfig config = CanaryConfig.builder().name("baseline").description("test")
+        .configVersion("1").application("demo").build();
+    when(storage.loadObject("config-store", ObjectType.CANARY_CONFIG, "config-id")).thenReturn(config);
+    when(storage.loadObject("object-store", ObjectType.METRIC_SET_PAIR_LIST, "pair-list"))
+        .thenReturn(List.of());
+
+    AtomicBoolean judgeWasInvoked = new AtomicBoolean();
+    CanaryJudge judge = new CanaryJudge() {
+      @Override public String getName() { return "example-judge"; }
+      @Override public CanaryJudgeResult judge(CanaryConfig actualConfig,
+          CanaryClassifierThresholdsConfig thresholds, List<MetricSetPair> pairs) {
+        judgeWasInvoked.set(true);
+        return CanaryJudgeResult.builder().judgeName("example-judge").results(List.of()).groupScores(List.of()).build();
+      }
+    };
+    ExecutionRepository executions = mock(ExecutionRepository.class);
+    PipelineExecution pipeline = mock(PipelineExecution.class);
+    StageExecution stage = mock(StageExecution.class);
+    when(executions.retrieve(PIPELINE, "comparison-1")).thenReturn(pipeline);
+    when(pipeline.getId()).thenReturn("comparison-1");
+    when(pipeline.getStages()).thenReturn(List.of(stage));
+    when(pipeline.getStatus()).thenReturn(ExecutionStatus.SUCCEEDED);
+    when(stage.getRefId()).thenReturn("compareJudgeResults");
+    when(stage.getOutputs()).thenReturn(Map.of("comparisonResult", Map.of("same", true)));
+    when(stage.getContext()).thenReturn(Map.of());
+    when(stage.getName()).thenReturn("Compare judges");
+    ExecutionMapper mapper = mock(ExecutionMapper.class);
+    CanaryExecutionResponse comparison = CanaryExecutionResponse.builder().canaryExecutionId("comparison-1").build();
+    when(mapper.buildJudgeComparisonExecution("judge-comparison", "judge-comparison", "config-id", config,
+        "judge-a", "judge-b", "pair-list", 0.95, 0.8, "config-store", "object-store"))
+        .thenReturn(comparison);
+
+    var listMvc = MockMvcBuilders.standaloneSetup(new CanaryJudgesController(
+        credentials, storageServices, executions, mapper, List.of(judge))).build();
+    listMvc.perform(get("/judges").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(jsonPath("$[0].name").value("example-judge"));
+    listMvc.perform(post("/judges/judge").param("canaryConfigId", "config-id")
+            .param("metricSetPairListId", "pair-list").param("passThreshold", "0.95")
+            .param("marginalThreshold", "0.8"))
+        .andExpect(status().isOk());
+    listMvc.perform(post("/judges/comparison").param("canaryConfigId", "config-id")
+            .param("metricSetPairListId", "pair-list").param("passThreshold", "0.95")
+            .param("marginalThreshold", "0.8").param("overrideCanaryJudge1", "judge-a")
+            .param("overrideCanaryJudge2", "judge-b").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(content().json("{\"canaryExecutionId\":\"comparison-1\"}"));
+    listMvc.perform(get("/judges/comparison/comparison-1").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(content().json("{\"comparisonResult\":{\"same\":true}}"));
+    org.junit.jupiter.api.Assertions.assertTrue(judgeWasInvoked.get());
+  }
