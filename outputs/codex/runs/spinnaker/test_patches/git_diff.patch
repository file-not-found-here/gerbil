+class AuthControllerApiTest {
+  @Test
+  void exposesAuthenticationAndSessionHttpRoutes() throws Exception {
+    PermissionService permissions = mock(PermissionService.class);
+    SessionService sessions = mock(SessionService.class);
+    User user = new User();
+    user.setUsername("alice");
+    user.setRoles(List.of("OLD_ROLE"));
+    when(permissions.getRoles("alice")).thenReturn(Set.of(new Role.View(new Role("platform-admin"))));
+    when(permissions.getServiceAccounts(user)).thenReturn(List.of("service-account@spinnaker"));
+    when(permissions.getServiceAccountsForApplication(user, "demo"))
+        .thenReturn(List.of("demo-sa@spinnaker"));
+    when(permissions.isAdmin("anonymous")).thenReturn(true);
+
+    AuthController controller = new AuthController(new URL("http://deck:9000"), null, sessions);
+    org.springframework.test.util.ReflectionTestUtils.setField(controller, "permissionService", permissions);
+    HandlerMethodArgumentResolver userResolver = new HandlerMethodArgumentResolver() {
+      @Override
+      public boolean supportsParameter(MethodParameter parameter) {
+        return parameter.hasParameterAnnotation(SpinnakerUser.class);
+      }
+
+      @Override
+      public Object resolveArgument(MethodParameter parameter, ModelAndViewContainer mavContainer,
+          NativeWebRequest webRequest, WebDataBinderFactory binderFactory) {
+        return user;
+      }
+    };
+    StandaloneMockMvcBuilder builder = MockMvcBuilders.standaloneSetup(controller);
+    var mvc = builder.setCustomArgumentResolvers(userResolver).build();
+
+    mvc.perform(get("/auth/loggedOut")).andExpect(status().isOk()).andExpect(content().string(org.hamcrest.Matchers.not("")));
+    mvc.perform(get("/auth/redirect").param("to", "http://deck:9000/applications"))
+        .andExpect(status().isFound()).andExpect(header().string("Location", "http://deck:9000/applications"));
+    mvc.perform(get("/auth/redirect").param("to", "http://attacker.invalid/"))
+        .andExpect(status().isBadRequest());
+    mvc.perform(get("/auth/user").accept("application/json"))
+        .andExpect(status().isOk()).andExpect(content().json("{\"username\":\"alice\",\"roles\":[\"platform-admin\"]}"));
+    mvc.perform(get("/auth/user/serviceAccounts").accept("application/json"))
+        .andExpect(status().isOk()).andExpect(content().json("[\"service-account@spinnaker\"]"));
+    mvc.perform(get("/auth/user/serviceAccounts").param("application", " demo ").accept("application/json"))
+        .andExpect(status().isOk()).andExpect(content().json("[\"demo-sa@spinnaker\"]"));
+    mvc.perform(post("/auth/deleteSessionCache")).andExpect(status().isOk());
+    mvc.perform(post("/auth/roles/sync")).andExpect(status().isOk());
+
+    verify(sessions).deleteSpringSessions();
+    verify(permissions).sync();
+  }
+}
