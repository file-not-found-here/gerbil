+class CredentialsReadApiTest {
+  @Test
+  @SuppressWarnings({"unchecked", "rawtypes"})
+  void readsCredentialAccountsByNameAndTypeOverHttp() throws Exception {
+    ClouddriverService.AccountDetails account = new ClouddriverService.AccountDetails();
+    account.setName("dev");
+    account.setAccountType("aws");
+    account.setCloudProvider("aws");
+    AccountLookupService lookup = mock(AccountLookupService.class);
+    when(lookup.getAccounts()).thenReturn(List.of(account));
+    AllowedAccountsSupport allowed = mock(AllowedAccountsSupport.class);
+    ClouddriverService clouddriver = mock(ClouddriverService.class);
+    ClouddriverService.AccountDefinition definition = new ClouddriverService.AccountDefinition();
+    definition.setName("dev");
+    definition.setType("aws");
+    Call<List<ClouddriverService.AccountDefinition>> definitions = mock(Call.class);
+    when(clouddriver.getAccountDefinitionsByType("aws", 10, "dev")).thenReturn(definitions);
+    when(definitions.execute()).thenReturn(Response.success(List.of(definition)));
+    Call<ClouddriverService.AccountDefinition> updated = mock(Call.class);
+    when(clouddriver.updateAccountDefinition(org.mockito.ArgumentMatchers.any())).thenReturn(updated);
+    when(updated.execute()).thenReturn(Response.success(definition));
+
+    CredentialsController controller = new CredentialsController();
+    ReflectionTestUtils.setField(controller, "accountLookupService", lookup);
+    ReflectionTestUtils.setField(controller, "allowedAccountsSupport", allowed);
+    ReflectionTestUtils.setField(controller, "clouddriverService", clouddriver);
+    ReflectionTestUtils.setField(controller, "objectMapper", new ObjectMapper());
+    HandlerMethodArgumentResolver anonymousUserResolver = new HandlerMethodArgumentResolver() {
+      @Override public boolean supportsParameter(MethodParameter parameter) {
+        return parameter.hasParameterAnnotation(SpinnakerUser.class);
+      }
+      @Override public Object resolveArgument(MethodParameter parameter, ModelAndViewContainer container,
+          NativeWebRequest request, WebDataBinderFactory binderFactory) { return null; }
+    };
+    var mvc = MockMvcBuilders.standaloneSetup(controller).setCustomArgumentResolvers(anonymousUserResolver).build();
+
+    mvc.perform(get("/credentials").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(jsonPath("$[0].authorized").value(false));
+    mvc.perform(get("/credentials/dev").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(jsonPath("$.name").value("dev"));
+    mvc.perform(get("/credentials/type/aws").param("limit", "10").param("startingAccountName", "dev")
+            .accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(content().json("[{\"name\":\"dev\",\"type\":\"aws\"}]"));
+    mvc.perform(put("/credentials").contentType(MediaType.APPLICATION_JSON)
+            .content("{\"name\":\"dev\",\"type\":\"aws\"}").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(jsonPath("$.name").value("dev"));
+  }
+}
