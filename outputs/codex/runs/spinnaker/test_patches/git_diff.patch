+    AccountDefinitionService service = mock(AccountDefinitionService.class);
+    var advice = new GenericExceptionHandlers(new ExceptionMessageDecorator(mock(ObjectProvider.class)));
+
+    mvc(service, mock(AccountCredentialsProvider.class), advice)
+        .perform(put("/credentials/path-name")
+            .contentType(MediaType.APPLICATION_JSON)
+            .content("{\"name\":\"body-name\"}"))
+        .andExpect(status().isBadRequest());
+  }
