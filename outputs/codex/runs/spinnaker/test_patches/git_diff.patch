+package com.netflix.spinnaker.orca.controllers;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.netflix.spinnaker.orca.api.pipeline.models.ExecutionType;
+import com.netflix.spinnaker.orca.api.pipeline.models.PipelineExecution;
+import com.netflix.spinnaker.orca.pipeline.persistence.ExecutionRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+class CorrelatedTasksControllerApiTest {
+  private ExecutionRepository executions;
+  private MockMvc mvc;
+
+  @BeforeEach
+  void setUp() {
+    executions = mock(ExecutionRepository.class);
+    mvc = MockMvcBuilders.standaloneSetup(new CorrelatedTasksController(executions)).build();
+  }
+
+  @Test
+  void returnsAnEmptyArrayWhenNoExecutionsHaveTheCorrelationId() throws Exception {
+    when(executions.retrieveByCorrelationId(any(ExecutionType.class), eq("missing"))).thenReturn(null);
+
+    mvc.perform(get("/executions/correlated/missing"))
+        .andExpect(status().isOk())
+        .andExpect(content().json("[]"));
+
+    verify(executions).retrieveByCorrelationId(ExecutionType.PIPELINE, "missing");
+    verify(executions).retrieveByCorrelationId(ExecutionType.ORCHESTRATION, "missing");
+  }
+  @Test
+  void returnsIdsFromBothExecutionTypes() throws Exception {
+    PipelineExecution pipeline = mock(PipelineExecution.class);
+    PipelineExecution orchestration = mock(PipelineExecution.class);
+    when(pipeline.getId()).thenReturn("pipeline-1");
+    when(orchestration.getId()).thenReturn("orchestration-1");
+    when(executions.retrieveByCorrelationId(ExecutionType.PIPELINE, "corr-1")).thenReturn(pipeline);
+    when(executions.retrieveByCorrelationId(ExecutionType.ORCHESTRATION, "corr-1"))
+        .thenReturn(orchestration);
+
+    mvc.perform(get("/executions/correlated/corr-1"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$[0]").value("pipeline-1"))
+        .andExpect(jsonPath("$[1]").value("orchestration-1"));
+  }
+
+}
