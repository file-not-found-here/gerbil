+class CanaryJudgesControllerApiTest {
+  @Test
+  void judgesHttpRoutesListJudgeCompareAndReturnComparisonResults() throws Exception {
+    AccountCredentialsRepository credentials = mock(AccountCredentialsRepository.class);
+    AccountCredentials configAccount = account("config-store");
+    AccountCredentials objectAccount = account("object-store");
+    when(credentials.getRequiredOneBy(null, AccountCredentials.Type.CONFIGURATION_STORE))
