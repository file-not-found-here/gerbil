+class ApplicationsControllerApiTest {
+  private MockMvc mvc;
+  private ApplicationProvider provider;
+
+  @BeforeEach
+  void setUp() {
+    provider = mock(ApplicationProvider.class);
+    ApplicationsController controller = new ApplicationsController();
+    ReflectionTestUtils.setField(controller, "applicationProviders", Collections.singletonList(provider));
+    ReflectionTestUtils.setField(controller, "clusterProviders", Collections.emptyList());
+    ReflectionTestUtils.setField(controller, "requestQueue", RequestQueue.noop());
+    mvc = MockMvcBuilders.standaloneSetup(controller)
+        .setControllerAdvice(
+            new GenericExceptionHandlers(
+                new ExceptionMessageDecorator(mock(ObjectProvider.class))))
+        .build();
+  }
+
+  @Test
+  void listsApplicationsSortedAndHonorsExpandQueryParameter() throws Exception {
+    Application zeta = application("zeta");
+    Application alpha = application("alpha");
+    doReturn(new HashSet<Application>(Set.of(zeta, alpha)))
+        .when(provider)
+        .getApplications(false);
+
+    mvc.perform(get("/applications")
+            .queryParam("expand", "false")
+            .queryParam("restricted", "false")
+            .accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$[0].name").value("alpha"))
+        .andExpect(jsonPath("$[1].name").value("zeta"));
+  }
+
+  @Test
+  void returnsNotFoundForAnUnknownApplication() throws Exception {
+    when(provider.getApplication("missing")).thenReturn(null);
+
+    mvc.perform(get("/applications/missing"))
+        .andExpect(status().isNotFound());
+  }
+
+  private static Application application(String name) {
+    return new TestApplication(name);
+  }
+
+  private static final class TestApplication implements Application {
+    private final String name;
+
+    private TestApplication(String name) {
+      this.name = name;
+    }
+
+    @Override
+    public String getName() {
+      return name;
+    }
+
+    @Override
+    public Map<String, String> getAttributes() {
+      return Collections.emptyMap();
+    }
+
+    @Override
+    public Map<String, Set<String>> getClusterNames() {
+      return Collections.emptyMap();
+    }
+  }
+}
