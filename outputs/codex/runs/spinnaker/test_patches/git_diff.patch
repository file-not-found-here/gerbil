+  @Test
+  void createsAValidScheduledActionAndReturnsCreated() throws Exception {
+    when(scheduler.getTrigger(any(TriggerKey.class))).thenReturn(null);
+    when(scheduler.scheduleJob(any(Trigger.class))).thenReturn(null);
+
+    mvc.perform(post("/scheduledActions")
+            .contentType(MediaType.APPLICATION_JSON)
+            .content("{\"id\":\"daily\",\"application\":\"demo\",\"pipelineId\":\"pipeline-1\",\"cronExpression\":\"0 0 12 * * ?\",\"timezone\":\"UTC\",\"forceRebake\":false}"))
+        .andExpect(status().isCreated())
