+        .andExpect(status().isOk())
+        .andExpect(content().json("{\"name\":\"job-1\",\"account\":\"demo\",\"id\":\"job-1\",\"location\":\"us-west-2\",\"provider\":\"test\",\"jobState\":\"Succeeded\"}"));
+    mvc.perform(get("/applications/demo/jobs/demo/us-west-2/job-1/result.json")
+            .accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk())
+        .andExpect(content().json("{\"content\":\"result contents\"}"));
