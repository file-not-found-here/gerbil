+    MockMvcBuilders.standaloneSetup(controller(provider))
+        .setControllerAdvice(advice)
+        .build()
+        .perform(get("/credentials/missing").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isNotFound());
