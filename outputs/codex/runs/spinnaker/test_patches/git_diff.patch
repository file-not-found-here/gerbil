+  @Test
+  void returnsArtifactNamesAndVersionsFromCredentials() throws Exception {
+    ArtifactCredentialsRepository repository = mock(ArtifactCredentialsRepository.class);
+    ArtifactCredentials credentials = mock(ArtifactCredentials.class);
+    when(repository.getCredentialsForType("registry", "docker")).thenReturn(credentials);
+    when(credentials.getArtifactNames()).thenReturn(Collections.singletonList("web"));
+    when(credentials.getArtifactVersions("web")).thenReturn(Collections.singletonList("1.2.3"));
+    MockMvc mvc = MockMvcBuilders.standaloneSetup(new ArtifactController(
+            Optional.of(repository), Optional.empty(), Optional.empty(), Optional.empty()))
