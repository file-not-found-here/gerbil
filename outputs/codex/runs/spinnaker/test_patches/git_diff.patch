+    AccountDefinitionService service = mock(AccountDefinitionService.class);
+    when(service.listAccountDefinitionsByType("aws", 100, null)).thenReturn(Collections.emptyList());
+    when(service.getAccountHistory("demo")).thenReturn(Collections.emptyList());
+    var mvc = mvc(service, mock(AccountCredentialsProvider.class));
+
+    mvc.perform(get("/credentials/type/aws").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(content().json("[]"));
+    mvc.perform(get("/credentials/demo/history").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(content().json("[]"));
+    mvc.perform(delete("/credentials/demo"))
+        .andExpect(status().isOk());
+
+    verify(service).deleteAccount("demo");
+  }
+
+  @Test
+  void createsSavesAndUpdatesAccountDefinitionsOverHttp() throws Exception {
+    AccountDefinitionService service = mock(AccountDefinitionService.class);
+    when(service.createAccount(any(CredentialsDefinition.class))).thenAnswer(call -> call.getArgument(0));
+    when(service.saveAccount(any(CredentialsDefinition.class))).thenAnswer(call -> call.getArgument(0));
+    when(service.updateAccount(any(CredentialsDefinition.class))).thenAnswer(call -> call.getArgument(0));
+    var mvc = mvc(service, mock(AccountCredentialsProvider.class));
+    String body = "{\"name\":\"demo\"}";
+
+    mvc.perform(post("/credentials").contentType(MediaType.APPLICATION_JSON).content(body)
+            .accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(content().json(body));
+    mvc.perform(put("/credentials").contentType(MediaType.APPLICATION_JSON).content(body)
+            .accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(content().json(body));
+    mvc.perform(put("/credentials/demo").contentType(MediaType.APPLICATION_JSON).content(body)
+            .accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk()).andExpect(content().json(body));
+
+    verify(service).createAccount(any(CredentialsDefinition.class));
+    verify(service).saveAccount(any(CredentialsDefinition.class));
+    verify(service).updateAccount(any(CredentialsDefinition.class));
+  }
