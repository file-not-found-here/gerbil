+    AccountCredentialsProvider provider = mock(AccountCredentialsProvider.class);
+    when(provider.getCredentials("missing")).thenReturn(null);
+    var advice = new GenericExceptionHandlers(new ExceptionMessageDecorator(mock(ObjectProvider.class)));
