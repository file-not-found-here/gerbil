+class PluginPublishControllerApiTest {
+  @Test
+  void verifiesAndUploadsPluginBinaryBeforePersistingMetadata() throws Exception {
+    byte[] archive = "sample plugin archive".getBytes(StandardCharsets.UTF_8);
+    String checksum = Hashing.sha512().hashBytes(archive).toString();
+    AtomicReference<byte[]> receivedBody = new AtomicReference<>();
+    HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+    server.createContext("/pluginBinaries/sample.plugin/1.0.0", exchange -> {
+      receivedBody.set(exchange.getRequestBody().readAllBytes());
+      exchange.sendResponseHeaders(201, -1);
+      exchange.close();
+    });
+    server.start();
+    try {
+      String front50Url = "http://127.0.0.1:" + server.getAddress().getPort();
+      Service front50 = new Service();
+      front50.setBaseUrl(front50Url);
+      ServiceConfiguration serviceConfiguration = new ServiceConfiguration();
+      serviceConfiguration.setServices(Map.of("front50", front50));
+
+      OkHttpClientProvider clientProvider = mock(OkHttpClientProvider.class);
+      when(clientProvider.getClient(any(DefaultServiceEndpoint.class))).thenReturn(new OkHttpClient());
+      TaskService taskService = mock(TaskService.class);
+      when(taskService.create(anyMap())).thenReturn(Map.of("ref", "task-1"));
+      PluginService pluginService = new PluginService(taskService, new SpinnakerExtensionsConfigProperties());
+      var controller = new PluginPublishController(
+          pluginService, clientProvider, serviceConfiguration, Map.of());
+      var mvc = MockMvcBuilders.standaloneSetup(controller).build();
+      String infoJson = "{\"id\":\"sample.plugin\",\"releases\":[{\"version\":\"1.0.0\",\"sha512sum\":\"" + checksum + "\"}]}";
+      MockMultipartFile pluginFile = new MockMultipartFile("plugin", "plugin.zip", "application/zip", archive);
+      MockMultipartFile infoPart = new MockMultipartFile("pluginInfo", "", "application/json", infoJson.getBytes(StandardCharsets.UTF_8));
+
+      mvc.perform(multipart("/plugins/publish/sample.plugin/1.0.0")
+              .file(pluginFile).file(infoPart).accept(MediaType.APPLICATION_JSON))
+          .andExpect(status().isOk());
+
+      org.junit.jupiter.api.Assertions.assertNotNull(receivedBody.get());
+      org.junit.jupiter.api.Assertions.assertTrue(
+          new String(receivedBody.get(), StandardCharsets.ISO_8859_1)
+              .contains(new String(archive, StandardCharsets.ISO_8859_1)));
+    } finally {
+      server.stop(0);
+    }
+  }
+}
