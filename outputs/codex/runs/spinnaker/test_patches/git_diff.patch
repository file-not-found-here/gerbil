+    mapper.addMixIn(OverrideVerificationRequest.class, OverrideVerificationRequestMixin.class);
+    mapper.addMixIn(RetryVerificationRequest.class, RetryVerificationRequestMixin.class);
+    return mapper;
+  }
+
+  abstract static class OverrideVerificationRequestMixin {
+    @JsonCreator
+    OverrideVerificationRequestMixin(
+        @JsonProperty("verificationId") String verificationId,
+        @JsonProperty("artifactReference") String artifactReference,
+        @JsonProperty("artifactVersion") String artifactVersion,
+        @JsonProperty("status") String status) {}
+  }
+
+  abstract static class RetryVerificationRequestMixin {
+    @JsonCreator
+    RetryVerificationRequestMixin(
+        @JsonProperty("verificationId") String verificationId,
+        @JsonProperty("artifactReference") String artifactReference,
+        @JsonProperty("artifactVersion") String artifactVersion) {}
+  }
+
+  private Object successResponseFor(InvocationOnMock invocation) {
+    String method = invocation.getMethod().getName();
+    Object body;
+    if (method.equals("getResourceStatus")) {
+      body = "AVAILABLE";
+    } else if (method.equals("getResourceYaml")) {
+      Resource resource = new Resource();
+      resource.setApiVersion("v1");
+      resource.setKind("Test");
+      body = resource;
+    } else if (method.equals("getManifestYaml")) {
+      DeliveryConfig config = new DeliveryConfig();
+      config.setName("demo");
+      body = config;
+    } else if (method.endsWith("Report")) {
+      body = ResponseBody.create("report", MediaType.parse("text/html"));
+    } else if (List.of("getManifestArtifacts", "getConstraintState", "getEnvironments", "diffManifest")
+        .contains(method)) {
+      body = List.of(Map.of("ok", true));
+    } else if (List.of("getApplicationDetails", "graphql", "schema", "validateManifest", "diffResource",
+        "exportArtifact").contains(method)) {
+      body = Map.of("ok", true);
+    } else {
+      body = null;
+    }
+    Call call = mock(Call.class);
+    try {
+      when(call.execute()).thenReturn(Response.success(body));
+    } catch (IOException e) {
+      throw new AssertionError(e);
+    }
+    return call;
+  }
+}
