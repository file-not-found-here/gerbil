+    PluginBinaryStorageService storage = mock(PluginBinaryStorageService.class);
+    byte[] bytes = "plugin archive".getBytes(java.nio.charset.StandardCharsets.UTF_8);
+    String checksum = Hashing.sha512().hashBytes(bytes).toString();
+    when(storage.getKey("sample.plugin", "1.0.0")).thenReturn("sample.plugin/1.0.0.zip");
+    when(storage.load("sample.plugin/1.0.0.zip")).thenReturn(bytes);
+    var mvc = MockMvcBuilders.standaloneSetup(new PluginBinaryController(Optional.of(storage))).build();
+
+    MockMultipartFile file = new MockMultipartFile("plugin", "plugin.zip", "application/zip", bytes);
+    mvc.perform(multipart("/pluginBinaries/sample.plugin/1.0.0")
+            .file(file).param("sha512sum", checksum))
+        .andExpect(status().isCreated());
+    mvc.perform(get("/pluginBinaries/sample.plugin/1.0.0"))
+        .andExpect(status().isOk())
+        .andExpect(header().string("Content-Type", "application/octet-stream"))
+        .andExpect(content().bytes(bytes));
+
+    verify(storage).store("sample.plugin/1.0.0.zip", bytes);
+  }
+}
