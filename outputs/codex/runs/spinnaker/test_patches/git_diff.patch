+    SchedulerFactoryBean schedulerBean = mock(SchedulerFactoryBean.class);
+    when(schedulerBean.getScheduler()).thenReturn(scheduler);
+    mvc = MockMvcBuilders.standaloneSetup(new ScheduledActionsController(schedulerBean))
