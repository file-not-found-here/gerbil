+  void forwardsProxyRequestAndReturnsUpstreamResponse() throws Exception {
+    HttpServer server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+    server.createContext("/resource", exchange -> {
+      byte[] body = "{\"upstream\":true}".getBytes(java.nio.charset.StandardCharsets.UTF_8);
+      exchange.getResponseHeaders().add("Content-Type", "application/json");
+      exchange.sendResponseHeaders(200, body.length);
+      exchange.getResponseBody().write(body);
+      exchange.close();
+    });
+    server.start();
+    try {
+      ProxyConfig config = new ProxyConfig();
+      config.setId("example");
+      config.setUri("http://127.0.0.1:" + server.getAddress().getPort());
+      ProxyConfigProvider configProvider = mock(ProxyConfigProvider.class);
+      doReturn(List.of(config)).when(configProvider).getProxyConfigs();
+      ObjectProvider<List<ProxyConfigProvider>> providers = mock(ObjectProvider.class);
+      when(providers.getIfAvailable()).thenReturn(List.of(configProvider));
+      OkHttpClientProvider clientProvider = mock(OkHttpClientProvider.class);
+      when(clientProvider.getClient(any())).thenReturn(new OkHttpClient());
+      ProxyController controller = new ProxyController(
+          new ObjectMapper(), new NoopRegistry(), clientProvider, providers);
+
+      MockMvcBuilders.standaloneSetup(controller).build()
+          .perform(get("/proxies/example/resource?key=value").accept("application/json"))
+          .andExpect(status().isOk())
+          .andExpect(header().string("X-Proxy-Status-Code", "200"))
+          .andExpect(content().json("{\"upstream\":true}"));
+    } finally {
+      server.stop(0);
+    }
+  }
+}
