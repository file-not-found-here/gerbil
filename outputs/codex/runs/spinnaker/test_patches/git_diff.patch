+class QueueAdminControllerApiTest {
+  @Test
+  void queueAdminRoutesHydratePushAndKillExecutions() throws Exception {
+    HydrateQueueCommand hydrate = mock(HydrateQueueCommand.class);
+    when(hydrate.invoke(any(HydrateQueueInput.class)))
+        .thenReturn(new HydrateQueueOutput(true, Map.of()));
+    ZombieExecutionService zombies = mock(ZombieExecutionService.class);
+    Queue queue = mock(Queue.class);
+    ExecutionRepository executions = mock(ExecutionRepository.class);
+    PipelineExecution execution = mock(PipelineExecution.class);
+    when(executions.retrieve(ExecutionType.PIPELINE, "exec-1")).thenReturn(execution);
+    com.fasterxml.jackson.databind.ObjectMapper messageMapper = OrcaObjectMapper.newInstance();
+    messageMapper.registerSubtypes(StartWaitingExecutions.class);
+    var mvc = MockMvcBuilders.standaloneSetup(
+            new QueueAdminController(hydrate, Optional.of(zombies), queue, executions))
+        .setMessageConverters(new org.springframework.http.converter.json.MappingJackson2HttpMessageConverter(
+            messageMapper))
+        .defaultRequest(get("/").accept(MediaType.APPLICATION_JSON)).build();
+
+    mvc.perform(post("/admin/queue/hydrate").param("dryRun", "false")
+            .param("executionId", "exec-1").param("startMs", "1000").param("endMs", "2000"))
+        .andExpect(status().isOk());
+    var input = org.mockito.ArgumentCaptor.forClass(HydrateQueueInput.class);
+    verify(hydrate).invoke(input.capture());
+    org.junit.jupiter.api.Assertions.assertFalse(input.getValue().getDryRun());
+    org.junit.jupiter.api.Assertions.assertEquals("exec-1", input.getValue().getExecutionId());
+    mvc.perform(post("/admin/queue/kickPending").param("pipelineConfigId", "config-1").param("purge", "true"))
+        .andExpect(status().isOk());
+    var message = org.mockito.ArgumentCaptor.forClass(com.netflix.spinnaker.q.Message.class);
+    verify(queue).push(message.capture());
+    org.junit.jupiter.api.Assertions.assertInstanceOf(StartWaitingExecutions.class, message.getValue());
+    StartWaitingExecutions waiting = (StartWaitingExecutions) message.getValue();
+    org.junit.jupiter.api.Assertions.assertEquals("config-1", waiting.getPipelineConfigId());
+    org.junit.jupiter.api.Assertions.assertTrue(waiting.getPurgeQueue());
+    mvc.perform(post("/admin/queue/pushMessage").contentType(MediaType.APPLICATION_JSON)
+            .content("{\"kind\":\"startWaitingExecutions\",\"pipelineConfigId\":\"config-2\",\"purgeQueue\":false}"))
+        .andExpect(status().isOk());
+    mvc.perform(post("/admin/queue/zombies:kill").param("minimumActivity", "15"))
+        .andExpect(status().isOk());
+    verify(zombies).killZombies(java.time.Duration.ofMinutes(15));
+    mvc.perform(post("/admin/queue/zombies/exec-1:kill")).andExpect(status().isNoContent());
+    verify(zombies).killZombie(execution);
+    mvc.perform(post("/admin/queue/zombies/application/storefront:kill").param("minimumActivity", "9"))
+        .andExpect(status().isNoContent());
+    verify(zombies).killZombies("storefront", java.time.Duration.ofMinutes(9));
+  }
+}
