+class OrcaAdminAndImportApiTest {
+  @Test
+  void adminEndpointsToggleStatusAndForceCancelWithDefaultQueryValues() throws Exception {
+    ExecutionRepository executions = mock(ExecutionRepository.class);
+    PipelineExecution execution = mock(PipelineExecution.class);
+    when(execution.getStatus()).thenReturn(RUNNING);
+    when(execution.getStages()).thenReturn(Collections.emptyList());
+    when(executions.retrieve(PIPELINE, "execution-1")).thenReturn(execution);
+    ForceExecutionCancellationCommand command =
+        new ForceExecutionCancellationCommand(executions, Clock.fixed(Instant.parse("2024-01-01T00:00:00Z"), ZoneOffset.UTC));
+    AdminController controller = new AdminController();
+    ReflectionTestUtils.setField(controller, "executionRepository", executions);
+    ReflectionTestUtils.setField(controller, "forceExecutionCancellationCommand", command);
+    var mvc = MockMvcBuilders.standaloneSetup(controller)
+        .defaultRequest(put("/").accept(MediaType.APPLICATION_JSON)).build();
+
+    mvc.perform(post("/admin/instance/enabled").contentType(MediaType.APPLICATION_JSON)
+            .content("{\"enabled\":false}"))
+        .andExpect(status().isOk());
+    mvc.perform(put("/admin/forceCancelExecution").param("executionId", "execution-1"))
+        .andExpect(status().isOk());
+    verify(executions).retrieve(PIPELINE, "execution-1");
+    verify(execution).setStatus(com.netflix.spinnaker.orca.api.pipeline.models.ExecutionStatus.CANCELED);
+    verify(execution).setCanceledBy("admin");
+    verify(executions).store(execution);
+  }
+
+  @Test
+  void importsOnlyNewTerminalExecutionsAndReturnsCreatedResponse() throws Exception {
+    ExecutionRepository executions = mock(ExecutionRepository.class);
+    Front50Service front50 = mock(Front50Service.class);
+    when(executions.retrieve(PIPELINE, "imported-1"))
+        .thenThrow(new ExecutionNotFoundException("not found"));
+    Application application = new Application();
+    ReflectionTestUtils.setField(application, "name", "storefront");
+    when(front50.get("storefront")).thenReturn(application);
+    var mapper = new MappingJackson2HttpMessageConverter(OrcaObjectMapper.getInstance());
+    var mvc = MockMvcBuilders.standaloneSetup(new ExecutionsImportController(executions, front50))
+        .setMessageConverters(mapper)
+        .defaultRequest(post("/").accept(MediaType.APPLICATION_JSON)).build();
+
+    mvc.perform(post("/admin/executions").contentType(MediaType.APPLICATION_JSON)
+            .content("{\"type\":\"PIPELINE\",\"id\":\"imported-1\",\"application\":\"storefront\",\"status\":\"CANCELED\",\"stages\":[]}"))
+        .andExpect(status().isCreated())
+        .andExpect(content().json("{\"executionId\":\"imported-1\",\"executionStatus\":\"CANCELED\",\"totalStages\":0}"));
+    verify(front50).get("storefront");
+    verify(executions).store(org.mockito.ArgumentMatchers.any(PipelineExecution.class));
+  }
+}
