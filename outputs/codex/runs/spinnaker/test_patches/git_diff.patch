+  @Test
+  void listsEmptyPipelineAndUserScheduledActions() throws Exception {
+    when(scheduler.getTriggerKeys(any(GroupMatcher.class))).thenReturn(Collections.emptySet());
+
+    mvc.perform(get("/scheduledActions").accept(MediaType.APPLICATION_JSON))
+        .andExpect(status().isOk())
+        .andExpect(content().json("{\"pipeline\":[],\"manuallyCreated\":[]}"));
+  }
+
+  @Test
