+    ArtifactReferenceURI uri = ArtifactReferenceURI.builder()
+        .uriPaths(java.util.Arrays.asList("demo", "hash"))
+        .build();
+    Artifact artifact = Artifact.builder().reference("ref://demo/hash").build();
+    when(uriBuilder.buildURIFromPaths("demo", "hash")).thenReturn(uri);
+    when(store.get(uri)).thenReturn(artifact);
+    MockMvc mvc = MockMvcBuilders.standaloneSetup(new ArtifactController(
+            Optional.empty(), Optional.empty(), Optional.of(store), Optional.of(uriBuilder)))
+        .build();
