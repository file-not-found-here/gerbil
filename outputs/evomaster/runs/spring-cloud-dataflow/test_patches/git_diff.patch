+                    "metadata-uri=http%3A%2F%2Flocalhost%3A44399%2FEM_SSRF_0&" + 
+                    "force=false&" + 
+                    "name=fg8g&" + 
+                    "name.y=UeSK&" + 
+                    "name.x=uu8RqaK7xKcXSMM")
+                .then()
+                .statusCode(201)
+                .assertThat()
