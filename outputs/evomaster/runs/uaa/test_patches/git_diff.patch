+                    "--database.password=");
+            port = Integer.parseInt(context.getEnvironment().getProperty("local.server.port"));
+            connection = DriverManager.getConnection(postgres.url(), "postgres", "");
+            snapshots = DriverManager.getConnection(postgres.url(), "postgres", "");
