+        Unsafe.setProperty("kylin.query.pushdown.jdbc.driver", "org.h2.Driver");
+        Unsafe.setProperty("kylin.query.pushdown.jdbc.username", "sa");
+        Unsafe.setProperty("kylin.query.pushdown.jdbc.password", "");
