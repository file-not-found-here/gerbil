+ */
+class RuntimeControllerTest extends AbstractControllerTest {
+
+	// --- GET /runtime/apps ---
+
+	@Test
+	void listRuntimeAppsReturnsEmptyPage() throws Exception {
+		when(skipperClient.states(any())).thenReturn(null);
+
+		mockMvc.perform(get("/runtime/apps").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
