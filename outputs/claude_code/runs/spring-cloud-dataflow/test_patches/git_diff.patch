+
+/**
+ * Tests for {@link TasksInfoController}, task logs, CTR options, and task validation endpoints.
+ */
+class TaskInfoAndValidationControllerTest extends AbstractControllerTest {
+
+	@Autowired
+	private TaskDefinitionRepository taskDefinitionRepository;
+
+	@AfterEach
+	void cleanup() {
+		taskDefinitionRepository.deleteAll();
+	}
+
+	// --- GET /tasks/info/executions ---
+
+	@Test
+	void getTaskInfoExecutionsReturnsCount() throws Exception {
+		mockMvc.perform(get("/tasks/info/executions").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
+				.andExpect(jsonPath("$.totalExecutions").exists());
+	}
+
+	@Test
+	void getTaskInfoExecutionsWithPlatformFilter() throws Exception {
+		mockMvc.perform(get("/tasks/info/executions")
+						.param("taskName", "nonexistent")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk());
+	}
+
+	// --- GET /tasks/logs/{taskExternalExecutionId} ---
+
+	@Test
+	void getTaskLogsForNonexistentExecutionReturnsOk() throws Exception {
+		// Task logs endpoint delegates to the platform launcher without validating exec ID existence
+		mockMvc.perform(get("/tasks/logs/nonexistent-exec-id")
+						.param("platformName", "default")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk());
+	}
+
+	// --- GET /tasks/ctr/options ---
+
+	@Test
+	void getCtrOptionsReturnsProperties() throws Exception {
+		mockMvc.perform(get("/tasks/ctr/options").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON));
+	}
+
+	// --- GET /tasks/validation/{name} ---
+
+	@Test
+	void validateNonexistentTaskDefinitionReturns404() throws Exception {
+		mockMvc.perform(get("/tasks/validation/nonexistent-task").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isNotFound());
+	}
+
+	@Test
+	void validateExistingTaskDefinitionReturnsValidationInfo() throws Exception {
+		// Register a task app first
+		mockMvc.perform(post("/apps/task/timestamp/1.0.0")
+						.param("uri", "maven://org.springframework.cloud.task.app:timestamp-task:1.0.0")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isCreated());
+
+		mockMvc.perform(post("/tasks/definitions")
+						.param("name", "valid-task")
+						.param("definition", "timestamp")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk());
+
+		mockMvc.perform(get("/tasks/validation/valid-task").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.appName").value("valid-task"));
+
+		// Cleanup
+		mockMvc.perform(delete("/tasks/definitions/valid-task"));
+		mockMvc.perform(delete("/apps/task/timestamp/1.0.0"));
+	}
+}
