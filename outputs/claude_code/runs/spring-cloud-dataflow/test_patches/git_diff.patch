+package org.springframework.cloud.dataflow.server.controller;
+
+import java.util.Collections;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.mockito.Mockito;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.mock.mockito.MockBean;
+import org.springframework.cloud.dataflow.server.test.TestDataFlowServerApplication;
+import org.springframework.cloud.skipper.client.SkipperClient;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.web.client.ResourceAccessException;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyBoolean;
+import static org.mockito.Mockito.when;
+
+/**
+ * Base class for controller tests providing common MockMvc setup and SkipperClient mock.
+ */
+@SpringBootTest(
+		classes = TestDataFlowServerApplication.class,
+		webEnvironment = SpringBootTest.WebEnvironment.MOCK
+)
+@AutoConfigureMockMvc
+public abstract class AbstractControllerTest {
+
+	@Autowired
+	protected MockMvc mockMvc;
+
+	@MockBean
+	protected SkipperClient skipperClient;
+
+	@BeforeEach
+	void setUpSkipperMocks() {
+		// Throw ResourceAccessException so AboutController's catch block handles it gracefully
+		when(skipperClient.info()).thenThrow(new ResourceAccessException("Skipper unavailable in tests"));
+		// Return empty collection so undeployStream skips Skipper deletion
+		when(skipperClient.search(any(), anyBoolean())).thenReturn(Collections.emptyList());
+		// Return null for states - handled by null check in SkipperStreamDeployer.streamsStates()
+		when(skipperClient.states(any())).thenReturn(null);
+		// Return empty list of deployers
+		when(skipperClient.listDeployers()).thenReturn(Collections.emptyList());
+	}
+}
