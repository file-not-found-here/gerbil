+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.page.size").value(10));
+	}
+
+	// --- GET /runtime/apps/{appId} ---
+
+	@Test
+	void getRuntimeAppByNonexistentIdReturns404() throws Exception {
+		mockMvc.perform(get("/runtime/apps/nonexistent-app").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isNotFound());
+	}
+
+	// --- GET /runtime/streams ---
+
+	@Test
+	void listRuntimeStreamStatusesReturnsEmpty() throws Exception {
+		Map<String, Map<String, DeploymentState>> emptyStates = new HashMap<>();
+		when(skipperClient.states(any())).thenReturn(emptyStates);
+
+		mockMvc.perform(get("/runtime/streams").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
