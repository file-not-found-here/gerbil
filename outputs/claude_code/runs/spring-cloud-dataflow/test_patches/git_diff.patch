+/**
+ * Tests for {@link AboutController}.
+ */
+class AboutControllerTest extends AbstractControllerTest {
+
+	@Test
+	void aboutReturnsServerInfo() throws Exception {
+		mockMvc.perform(get("/about").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
+				.andExpect(jsonPath("$.featureInfo").exists())
+				.andExpect(jsonPath("$.versionInfo").exists())
+				.andExpect(jsonPath("$.securityInfo").exists())
+				.andExpect(jsonPath("$.runtimeEnvironment").exists());
+	}
+
+	@Test
+	void aboutReturnsFeatureFlags() throws Exception {
+		mockMvc.perform(get("/about").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.featureInfo.streamsEnabled").value(true))
+				.andExpect(jsonPath("$.featureInfo.tasksEnabled").value(true));
+	}
+
+	@Test
+	void aboutReturnsVersionInfo() throws Exception {
+		mockMvc.perform(get("/about").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.versionInfo.implementation").exists())
+				.andExpect(jsonPath("$.versionInfo.core").exists())
+				.andExpect(jsonPath("$.versionInfo.dashboard").exists())
+				.andExpect(jsonPath("$.versionInfo.shell").exists());
+	}
+
+	@Test
+	void aboutReturnsSecurityInfoWithAuthDisabled() throws Exception {
+		mockMvc.perform(get("/about").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.securityInfo.authenticationEnabled").value(false));
+	}
+
+	@Test
+	void aboutReturnsSelfLink() throws Exception {
+		mockMvc.perform(get("/about").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$._links.self").exists());
+	}
+}
