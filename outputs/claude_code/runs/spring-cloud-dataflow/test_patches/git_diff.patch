+				.andExpect(jsonPath("$.page.totalElements").value(0));
+	}
+
+	@Test
+	void listRuntimeStreamStatusesWithPageable() throws Exception {
+		mockMvc.perform(get("/runtime/streams")
+						.param("page", "0")
+						.param("size", "5")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.page.size").value(5));
+	}
+
+	// --- GET /runtime/streams/{streamNames} ---
+
+	@Test
+	void getSpecificRuntimeStreamStatusReturnsEmptyForUnknownStream() throws Exception {
+		mockMvc.perform(get("/runtime/streams/nosuchstream").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk());
