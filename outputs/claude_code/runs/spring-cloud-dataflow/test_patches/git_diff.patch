+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isCreated())
+				.andExpect(jsonPath("$.name").value("described-stream"))
+				.andExpect(jsonPath("$.description").value("A time-to-log stream"));
+	}
+
+	@Test
+	void saveDuplicateStreamDefinitionFails() throws Exception {
+		mockMvc.perform(post("/streams/definitions")
+						.param("name", "dup-stream")
+						.param("definition", "time | log")
+						.contentType(MediaType.APPLICATION_FORM_URLENCODED)
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isCreated());
