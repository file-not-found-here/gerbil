+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isConflict());
+	}
+
+	// --- POST /streams/definitions (json) ---
+
+	@Test
+	void saveStreamDefinitionViaJsonPost() throws Exception {
+		mockMvc.perform(post("/streams/definitions")
+						.param("name", "json-stream")
+						.param("definition", "time | log")
+						.contentType(MediaType.APPLICATION_JSON)
+						.content("{}")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isCreated())
+				.andExpect(jsonPath("$.name").value("json-stream"));
+	}
+
+	// --- GET /streams/definitions/{name} ---
+
+	@Test
+	void getStreamDefinitionByName() throws Exception {
+		mockMvc.perform(post("/streams/definitions")
