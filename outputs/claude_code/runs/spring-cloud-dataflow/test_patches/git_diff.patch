+package org.springframework.cloud.dataflow.server.controller;
+
+import org.junit.jupiter.api.Test;
+
+import org.springframework.http.MediaType;
+
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+/**
+ * Tests for {@link ToolsController}.
+ */
+class ToolsControllerTest extends AbstractControllerTest {
+
+	// --- POST /tools/parseTaskTextToGraph ---
+
+	@Test
+	void parseSimpleTaskTextToGraph() throws Exception {
+		String request = "{\"name\":\"my-task\",\"dsl\":\"timestamp\"}";
+
+		mockMvc.perform(post("/tools/parseTaskTextToGraph")
+						.content(request)
+						.contentType(MediaType.APPLICATION_JSON)
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
+				.andExpect(jsonPath("$.graph").exists());
+	}
+
+	@Test
+	void parseComposedTaskTextToGraph() throws Exception {
+		String request = "{\"name\":\"composed\",\"dsl\":\"task1 && task2\"}";
+
+		mockMvc.perform(post("/tools/parseTaskTextToGraph")
+						.content(request)
+						.contentType(MediaType.APPLICATION_JSON)
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.graph").exists());
+	}
+
+	@Test
+	void parseInvalidTaskDslReturnsErrors() throws Exception {
+		String request = "{\"name\":\"bad-task\",\"dsl\":\"&&invalid&&\"}";
+
+		mockMvc.perform(post("/tools/parseTaskTextToGraph")
+						.content(request)
+						.contentType(MediaType.APPLICATION_JSON)
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.errors").isArray())
+				.andExpect(jsonPath("$.errors[0]").exists());
+	}
+
+	// --- POST /tools/convertTaskGraphToText ---
+
+	@Test
+	void convertSimpleGraphToText() throws Exception {
+		// A simple linear graph: start → task1 → end
+		String graphJson = "{"
+				+ "\"nodes\":["
+				+ "{\"id\":\"0\",\"name\":\"START\"},"
+				+ "{\"id\":\"1\",\"name\":\"timestamp\",\"metadata\":{\"label\":\"timestamp\"}},"
+				+ "{\"id\":\"2\",\"name\":\"END\"}"
+				+ "],"
+				+ "\"links\":["
+				+ "{\"from\":\"0\",\"to\":\"1\"},"
+				+ "{\"from\":\"1\",\"to\":\"2\"}"
+				+ "]"
+				+ "}";
+
+		mockMvc.perform(post("/tools/convertTaskGraphToText")
+						.content(graphJson)
+						.contentType(MediaType.APPLICATION_JSON)
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
+				.andExpect(jsonPath("$.dsl").exists());
+	}
+
+	@Test
+	void convertMinimalGraphToTextReturnsEmptyDsl() throws Exception {
+		// A minimal graph with only START and END (no task nodes) produces an empty DSL
+		String graphJson = "{"
+				+ "\"nodes\":["
+				+ "{\"id\":\"0\",\"name\":\"START\"},"
+				+ "{\"id\":\"1\",\"name\":\"END\"}"
+				+ "],"
+				+ "\"links\":["
+				+ "{\"from\":\"0\",\"to\":\"1\"}"
+				+ "]"
+				+ "}";
+
+		mockMvc.perform(post("/tools/convertTaskGraphToText")
+						.content(graphJson)
+						.contentType(MediaType.APPLICATION_JSON)
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk());
+	}
+}
