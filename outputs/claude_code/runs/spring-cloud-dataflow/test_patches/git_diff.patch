+
+/**
+ * Tests for {@link StreamDefinitionController}.
+ */
+class StreamDefinitionControllerTest extends AbstractControllerTest {
+
+	@Autowired
+	private StreamDefinitionRepository streamDefinitionRepository;
+
+	@Autowired
+	private AppRegistryService appRegistryService;
+
+	@BeforeEach
+	void registerApps() throws Exception {
+		mockMvc.perform(post("/apps/source/time/3.0.0")
+						.param("uri", "maven://org.springframework.cloud.stream.app:time-source:3.0.0")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isCreated());
+		mockMvc.perform(post("/apps/sink/log/3.0.0")
+						.param("uri", "maven://org.springframework.cloud.stream.app:log-sink:3.0.0")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isCreated());
+		mockMvc.perform(post("/apps/processor/filter/3.0.0")
+						.param("uri", "maven://org.springframework.cloud.stream.app:filter-processor:3.0.0")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isCreated());
+	}
+
+	@AfterEach
+	void cleanupStreams() {
+		streamDefinitionRepository.deleteAll();
+		appRegistryService.findAll().forEach(app ->
+				appRegistryService.delete(app.getName(), app.getType(), app.getVersion()));
+	}
+
+	// --- GET /streams/definitions ---
+
+	@Test
+	void listStreamDefinitionsReturnsEmptyPage() throws Exception {
+		mockMvc.perform(get("/streams/definitions").accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
+				.andExpect(jsonPath("$.page").exists())
+				.andExpect(jsonPath("$.page.totalElements").value(0));
+	}
+
+	@Test
+	void listStreamDefinitionsWithSearchFilter() throws Exception {
+		mockMvc.perform(get("/streams/definitions")
+						.param("search", "nonexistent")
+						.accept(MediaType.APPLICATION_JSON))
+				.andExpect(status().isOk())
+				.andExpect(jsonPath("$.page.totalElements").value(0));
+	}
+
+	// --- POST /streams/definitions (form) ---
+
+	@Test
+	void saveStreamDefinitionViaFormPost() throws Exception {
+		mockMvc.perform(post("/streams/definitions")
+						.param("name", "simple-stream")
+						.param("definition", "time | log")
+						.contentType(MediaType.APPLICATION_FORM_URLENCODED)
+						.accept(MediaType.APPLICATION_JSON))
