+
+	@Test
+	void deleteAllStreamDefinitions() throws Exception {
+		mockMvc.perform(post("/streams/definitions")
+						.param("name", "all-del-stream1")
+						.param("definition", "time | log")
+						.contentType(MediaType.APPLICATION_FORM_URLENCODED)
