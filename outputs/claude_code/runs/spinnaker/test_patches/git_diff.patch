+
+    mockMvc
+        .perform(get("/certificates"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$").isArray())
+        .andExpect(jsonPath("$").isEmpty());
+  }
+
+  @Test
+  void listCertificates_singleCert_returnsCorrectFields() throws Exception {
+    Certificate cert = makeCert("cert-123", "my-cert");
+    when(certificateProvider.getAll()).thenReturn(Collections.singleton(cert));
+
+    mockMvc
+        .perform(get("/certificates"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$[0].serverCertificateId").value("cert-123"))
+        .andExpect(jsonPath("$[0].serverCertificateName").value("my-cert"));
+  }
+
+  @Test
+  void listCertificatesByCloudProvider_filtersToMatchingProvider() throws Exception {
+    when(certificateProvider.getCloudProvider()).thenReturn("aws");
+    Certificate cert = makeCert("cert-123", "my-cert");
+    when(certificateProvider.getAll()).thenReturn(Collections.singleton(cert));
+
+    mockMvc
+        .perform(get("/certificates/aws"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$").isArray())
+        .andExpect(jsonPath("$.length()").value(1));
