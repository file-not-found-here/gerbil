+
+@ExtendWith(MockitoExtension.class)
+class CertificateControllerTest {
+
+  @Mock CertificateProvider certificateProvider;
+
+  private MockMvc mockMvc;
+
+  @BeforeEach
+  void setUp() {
+    CertificateController controller = new CertificateController();
+    ReflectionTestUtils.setField(controller, "certificateProviders", List.of(certificateProvider));
+    mockMvc =
+        MockMvcBuilders.standaloneSetup(controller)
+            .setMessageConverters(new MappingJackson2HttpMessageConverter())
+            .build();
+  }
+
+  private Certificate makeCert(String certId, String certName) {
+    Certificate cert = new Certificate();
+    cert.setServerCertificateId(certId);
+    cert.setServerCertificateName(certName);
+    cert.setPath("/");
+    cert.setExpiration(new Date());
+    return cert;
+  }
+
+  @Test
+  void listCertificates_returnsAllCertificatesSorted() throws Exception {
+    Certificate certB = makeCert("cert-2", "my-cert-b");
+    Certificate certA = makeCert("cert-1", "my-cert-a");
+    Set<Certificate> certs = new HashSet<>(Arrays.asList(certB, certA));
+    when(certificateProvider.getAll()).thenReturn(certs);
+
+    mockMvc
+        .perform(get("/certificates"))
+        .andExpect(status().isOk())
+        .andExpect(content().contentTypeCompatibleWith("application/json"))
+        .andExpect(jsonPath("$").isArray())
+        .andExpect(jsonPath("$.length()").value(2))
+        .andExpect(jsonPath("$[0].serverCertificateName").value("my-cert-a"))
+        .andExpect(jsonPath("$[1].serverCertificateName").value("my-cert-b"));
+  }
+
+  @Test
+  void listCertificates_returnsEmptyListWhenNone() throws Exception {
