+        SearchResultSet.builder()
+            .totalMatches(50)
+            .pageNumber(2)
+            .pageSize(10)
+            .platform("aws")
+            .query("test")
+            .results(Collections.emptyList())
+            .build();
+    when(searchExecutor.searchAllProviders(anyList(), any(SearchQueryCommand.class)))
+        .thenReturn(Collections.singletonList(resultSet));
+
+    mockMvc
+        .perform(
+            get("/search")
+                .param("type", "applications")
+                .param("pageSize", "10")
+                .param("page", "2"))
+        .andExpect(status().isOk());
+  }
+
+  @Test
+  void search_singleProviderResult_returnsSingleResultSet() throws Exception {
+    SearchResultSet resultSet = makeResultSet("aws", 5);
+    when(searchExecutor.searchAllProviders(anyList(), any(SearchQueryCommand.class)))
+        .thenReturn(Collections.singletonList(resultSet));
+
+    mockMvc
+        .perform(get("/search").param("type", "serverGroups").param("q", "test"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$").isArray())
+        .andExpect(jsonPath("$.length()").value(1));
+  }
+
+  @Test
+  void search_multipleProviderResults_mergesIntoSingleResultSet() throws Exception {
+    SearchResultSet resultSet1 = makeResultSet("aws", 2);
+    SearchResultSet resultSet2 = makeResultSet("gce", 3);
+    when(searchExecutor.searchAllProviders(anyList(), any(SearchQueryCommand.class)))
+        .thenReturn(Arrays.asList(resultSet1, resultSet2));
+
+    mockMvc
+        .perform(get("/search").param("type", "applications"))
