+package com.netflix.spinnaker.clouddriver;
+
+import org.springframework.boot.SpringBootConfiguration;
+import org.springframework.boot.autoconfigure.EnableAutoConfiguration;
+import org.springframework.boot.autoconfigure.batch.BatchAutoConfiguration;
+import org.springframework.boot.autoconfigure.data.elasticsearch.ElasticsearchDataAutoConfiguration;
+import org.springframework.boot.autoconfigure.groovy.template.GroovyTemplateAutoConfiguration;
+import org.springframework.boot.autoconfigure.gson.GsonAutoConfiguration;
+import org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration;
+
+/**
+ * Minimal Spring Boot configuration for @WebMvcTest slice tests.
+ *
+ * <p>Main.groovy uses @Configuration (not @SpringBootApplication), so @WebMvcTest cannot find the
+ * bootstrap class automatically. This class provides the @SpringBootConfiguration anchor without
+ * loading the full production context.
+ */
+@SpringBootConfiguration
+@EnableAutoConfiguration(
+    exclude = {
+      BatchAutoConfiguration.class,
+      GroovyTemplateAutoConfiguration.class,
+      GsonAutoConfiguration.class,
+      DataSourceAutoConfiguration.class,
+      ElasticsearchDataAutoConfiguration.class
+    })
+public class TestApplication {}
