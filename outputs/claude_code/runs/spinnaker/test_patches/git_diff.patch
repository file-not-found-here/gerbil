+            .setMessageConverters(new MappingJackson2HttpMessageConverter())
+            .build();
+  }
+
+  private SearchResultSet makeResultSet(String platform, int total) {
+    Map<String, Object> result = new HashMap<>();
+    result.put("name", "test-app");
+    result.put("type", "applications");
+    return SearchResultSet.builder()
+        .totalMatches(total)
+        .pageNumber(1)
+        .pageSize(10000)
+        .platform(platform)
+        .query("test")
+        .results(total > 0 ? Collections.singletonList(result) : Collections.emptyList())
+        .build();
+  }
+
+  @Test
+  void search_withTypeParam_returnsResultSets() throws Exception {
+    SearchResultSet resultSet = makeResultSet("aws", 1);
+    when(searchExecutor.searchAllProviders(anyList(), any(SearchQueryCommand.class)))
+        .thenReturn(Collections.singletonList(resultSet));
+
+    mockMvc
+        .perform(get("/search").param("type", "applications").param("q", "test"))
+        .andExpect(status().isOk())
+        .andExpect(content().contentTypeCompatibleWith("application/json"))
+        .andExpect(jsonPath("$").isArray());
