+package com.netflix.spinnaker.clouddriver.controllers;
+
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;
+
+import com.netflix.spinnaker.clouddriver.model.Application;
+import com.netflix.spinnaker.clouddriver.model.ApplicationProvider;
+import com.netflix.spinnaker.clouddriver.model.ClusterProvider;
+import com.netflix.spinnaker.clouddriver.requestqueue.RequestQueue;
+import com.netflix.spinnaker.kork.web.exceptions.NotFoundException;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.context.support.ResourceBundleMessageSource;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.converter.json.MappingJackson2HttpMessageConverter;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+@ExtendWith(MockitoExtension.class)
+class ApplicationsControllerTest {
+
+  @Mock ApplicationProvider applicationProvider;
+  @Mock ClusterProvider clusterProvider;
+
+  private MockMvc mockMvc;
+
+  @BeforeEach
+  void setUp() {
+    ApplicationsController controller = new ApplicationsController();
+    ReflectionTestUtils.setField(controller, "applicationProviders", List.of(applicationProvider));
+    ReflectionTestUtils.setField(controller, "clusterProviders", List.of(clusterProvider));
+    ReflectionTestUtils.setField(controller, "messageSource", new ResourceBundleMessageSource());
+    ReflectionTestUtils.setField(controller, "requestQueue", RequestQueue.noop());
+    mockMvc =
+        MockMvcBuilders.standaloneSetup(controller)
+            .setControllerAdvice(new NotFoundExceptionHandler())
+            .setMessageConverters(new MappingJackson2HttpMessageConverter())
+            .build();
+  }
+
+  @ControllerAdvice
+  static class NotFoundExceptionHandler {
+    @ExceptionHandler(NotFoundException.class)
+    @ResponseStatus(HttpStatus.NOT_FOUND)
+    public void handle() {}
+  }
+
+  private Application makeApp(String name) {
+    return new Application() {
+      @Override
+      public String getName() {
+        return name;
+      }
+
+      @Override
+      public Map<String, String> getAttributes() {
+        Map<String, String> attrs = new HashMap<>();
+        attrs.put("email", name + "@example.com");
+        return attrs;
+      }
+
+      @Override
+      public Map<String, Set<String>> getClusterNames() {
+        return Collections.emptyMap();
+      }
+    };
+  }
+
+  @Test
+  void listApplications_returnsEmptyArrayWhenNoApps() throws Exception {
+    doReturn(Collections.emptySet()).when(applicationProvider).getApplications(anyBoolean());
+
+    mockMvc
+        .perform(get("/applications"))
+        .andExpect(status().isOk())
+        .andExpect(content().contentTypeCompatibleWith("application/json"))
+        .andExpect(jsonPath("$").isArray())
+        .andExpect(jsonPath("$").isEmpty());
+  }
+
+  @Test
+  void listApplications_returnsSortedApps() throws Exception {
+    Application appB = makeApp("bravo");
+    Application appA = makeApp("alpha");
+    Set<Application> apps = new HashSet<>(Arrays.asList(appB, appA));
+    doReturn(apps).when(applicationProvider).getApplications(anyBoolean());
+
+    mockMvc
+        .perform(get("/applications"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$").isArray())
+        .andExpect(jsonPath("$.length()").value(2));
+  }
+
+  @Test
+  void listApplications_withExpandFalse_returnsApps() throws Exception {
+    Application app = makeApp("myapp");
+    doReturn(Collections.singleton(app)).when(applicationProvider).getApplications(false);
+
+    mockMvc
+        .perform(get("/applications").param("expand", "false"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$").isArray())
+        .andExpect(jsonPath("$.length()").value(1));
+  }
+
+  @Test
+  void getApplication_returnsApplicationViewModel() throws Exception {
+    Application app = makeApp("myapp");
+    when(applicationProvider.getApplication("myapp")).thenReturn(app);
+    when(clusterProvider.getClusterSummaries("myapp")).thenReturn(Collections.emptyMap());
+
+    mockMvc
+        .perform(get("/applications/myapp"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.name").value("myapp"));
+  }
+
+  @Test
+  void getApplication_returnsNotFoundWhenAppMissing() throws Exception {
+    when(applicationProvider.getApplication("nonexistent")).thenReturn(null);
+
+    mockMvc
+        .perform(get("/applications/nonexistent"))
+        .andExpect(status().isNotFound());
+  }
+
+  @Test
+  void listApplications_withNullResultsFromProvider_filtersNulls() throws Exception {
+    Set<Application> apps = Collections.singleton(makeApp("alpha"));
+    doReturn(apps).when(applicationProvider).getApplications(anyBoolean());
+
+    mockMvc
+        .perform(get("/applications"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.length()").value(1))
+        .andExpect(jsonPath("$[0].name").value("alpha"));
+  }
+
+  @Test
+  void getApplication_withClusterData_includesClustersInResponse() throws Exception {
+    Application app = makeApp("myapp");
+    when(applicationProvider.getApplication("myapp")).thenReturn(app);
+    when(clusterProvider.getClusterSummaries("myapp")).thenReturn(Collections.emptyMap());
+
+    mockMvc
+        .perform(get("/applications/myapp"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.name").value("myapp"))
+        .andExpect(jsonPath("$.clusters").exists());
+  }
+
+  @Test
+  void listApplications_withRestrictedFalse_returnsApps() throws Exception {
+    Application app = makeApp("myapp");
+    doReturn(Collections.singleton(app)).when(applicationProvider).getApplications(anyBoolean());
+
+    mockMvc
+        .perform(get("/applications").param("restricted", "false"))
+        .andExpect(status().isOk())
+        .andExpect(jsonPath("$.length()").value(1));
+  }
+}
