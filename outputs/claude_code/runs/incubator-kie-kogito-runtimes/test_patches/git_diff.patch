+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Integration tests for the Task Management REST API at /management/usertasks.
+ * Tests reading and updating user tasks across all processes.
+ */
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+class TaskManagementApiTest {
+
+    static final String TRAVELLER_BODY = "{"
+            + "\"traveller\": {"
+            + "  \"firstName\": \"Task\","
+            + "  \"lastName\": \"Test\","
+            + "  \"email\": \"task.test@example.com\","
+            + "  \"nationality\": \"US\","
+            + "  \"address\": {"
+            + "    \"street\": \"Task St\","
+            + "    \"city\": \"Task City\","
+            + "    \"zipCode\": \"00000\","
+            + "    \"country\": \"US\""
+            + "  }"
+            + "}"
+            + "}";
+
+    @LocalServerPort
+    int port;
+
+    @BeforeEach
+    void setUp() {
+        RestAssured.port = port;
+    }
+
+    @Test
+    void testGetUnknownUserTaskReturns404OrError() {
+        int status = given()
+                .accept(ContentType.JSON)
+                .when()
+                .get("/management/usertasks/00000000-0000-0000-0000-000000000000")
+                .then()
+                .extract()
+                .statusCode();
+
+        assertThat(status).isIn(404, 400, 500);
+    }
+
+    @Test
+    void testGetExistingUserTaskReturns200() {
+        String instanceId = startApprovalInstance();
+
+        try {
+            String taskId = getFirstTaskId(instanceId);
+
+            Map<String, Object> taskInfo = given()
+                    .accept(ContentType.JSON)
+                    .queryParam("user", "manager")
+                    .when()
+                    .get("/management/usertasks/{taskId}", taskId)
+                    .then()
+                    .statusCode(200)
+                    .contentType(ContentType.JSON)
+                    .extract()
+                    .jsonPath()
+                    .getMap(".");
+
+            assertThat(taskInfo).isNotEmpty();
+        } finally {
+            deleteApprovalInstance(instanceId);
+        }
+    }
+
+    @Test
+    void testPatchExistingUserTaskReturns200() {
+        String instanceId = startApprovalInstance();
+
+        try {
+            String taskId = getFirstTaskId(instanceId);
+
+            given()
+                    .contentType(ContentType.JSON)
+                    .accept(ContentType.JSON)
+                    .queryParam("user", "manager")
+                    .body("{\"description\": \"Updated description\"}")
+                    .when()
+                    .patch("/management/usertasks/{taskId}", taskId)
+                    .then()
+                    .statusCode(200)
+                    .contentType(ContentType.JSON);
+        } finally {
+            deleteApprovalInstance(instanceId);
+        }
+    }
+
+    @Test
+    void testPutExistingUserTaskReturns200() {
+        String instanceId = startApprovalInstance();
+
+        try {
+            String taskId = getFirstTaskId(instanceId);
+
+            given()
+                    .contentType(ContentType.JSON)
+                    .accept(ContentType.JSON)
+                    .queryParam("user", "manager")
+                    .body("{"
+                            + "\"description\": \"Put description\","
+                            + "\"priority\": \"Low\","
+                            + "\"potentialUsers\": [],"
+                            + "\"potentialGroups\": [\"managers\"],"
+                            + "\"excludedUsers\": [],"
+                            + "\"adminUsers\": [],"
+                            + "\"adminGroups\": []"
+                            + "}")
+                    .when()
+                    .put("/management/usertasks/{taskId}", taskId)
+                    .then()
+                    .statusCode(200);
+        } finally {
+            deleteApprovalInstance(instanceId);
+        }
+    }
+
+    private String startApprovalInstance() {
+        return given()
+                .contentType(ContentType.JSON)
+                .accept(ContentType.JSON)
+                .body(TRAVELLER_BODY)
+                .when()
+                .post("/approvals")
+                .then()
+                .statusCode(201)
+                .extract()
+                .path("id");
+    }
+
+    private String getFirstTaskId(String instanceId) {
+        return given()
+                .contentType(ContentType.JSON)
+                .accept(ContentType.JSON)
+                .queryParam("user", "manager")
+                .queryParam("group", "managers")
+                .when()
+                .get("/usertasks/instance")
+                .then()
+                .statusCode(200)
+                .extract()
+                .jsonPath()
+                .getString("[0].id");
+    }
+
+    private void deleteApprovalInstance(String id) {
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .delete("/approvals/{id}", id);
+    }
