+/**
+ * Integration tests for the cinema BPMN process (cinema.bpmn).
+ * This process manages movie review rating with a "ReviewRatingTask" user task.
+ */
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+class CinemaProcessTest {
+
+    static final String MOVIE_BODY = "{"
+            + "\"movie\": {"
+            + "  \"name\": \"Test Movie\","
+            + "  \"releaseYear\": 2023,"
+            + "  \"genre\": \"COMEDY\""
+            + "}"
+            + "}";
+
+    @LocalServerPort
+    int port;
+
+    @BeforeEach
+    void setUp() {
+        RestAssured.port = port;
+    }
+
+    @Test
+    void testStartCinemaProcessReturns201() {
+        JsonPath result = given()
+                .contentType(ContentType.JSON)
+                .accept(ContentType.JSON)
+                .body(MOVIE_BODY)
+                .when()
+                .post("/cinema")
+                .then()
+                .statusCode(201)
+                .contentType(ContentType.JSON)
+                .body("id", notNullValue())
+                .extract()
+                .jsonPath();
+
+        String id = result.getString("id");
+        assertThat(id).isNotBlank();
+        deleteCinemaInstance(id);
+    }
+
+    @Test
+    void testCinemaProcessResponseContainsMovieData() {
+        JsonPath result = given()
+                .contentType(ContentType.JSON)
+                .accept(ContentType.JSON)
+                .body(MOVIE_BODY)
+                .when()
+                .post("/cinema")
+                .then()
+                .statusCode(201)
+                .extract()
+                .jsonPath();
+
+        String id = result.getString("id");
+        assertThat(result.getString("movie.name")).isEqualTo("Test Movie");
+        assertThat(result.getInt("movie.releaseYear")).isEqualTo(2023);
+        assertThat(result.getString("movie.genre")).isEqualTo("COMEDY");
+        deleteCinemaInstance(id);
+    }
+
+    @Test
+    void testListCinemaProcessesReturns200() {
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .get("/cinema")
+                .then()
+                .statusCode(200)
+                .contentType(ContentType.JSON);
+    }
+
+    @Test
+    void testGetCinemaInstanceByIdReturns200() {
+        String id = startCinemaInstance();
+
+        try {
+            given()
+                    .accept(ContentType.JSON)
+                    .when()
+                    .get("/cinema/{id}", id)
+                    .then()
+                    .statusCode(200)
+                    .contentType(ContentType.JSON)
+                    .body("id", notNullValue());
+        } finally {
+            deleteCinemaInstance(id);
+        }
