+package org.kie.kogito.integrationtests.springboot;
+
+import java.util.List;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.web.server.LocalServerPort;
+
+import io.restassured.RestAssured;
+import io.restassured.http.ContentType;
+import io.restassured.path.json.JsonPath;
+
+import static io.restassured.RestAssured.given;
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.notNullValue;
+
+/**
+ * Integration tests for the approvals BPMN process.
+ * Tests CRUD operations, task listing, task completion, and process management interactions.
+ */
+@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+class ApprovalsProcessTest {
+
+    static final String TRAVELLER_BODY = "{"
+            + "\"traveller\": {"
+            + "  \"firstName\": \"John\","
+            + "  \"lastName\": \"Doe\","
+            + "  \"email\": \"john.doe@example.com\","
+            + "  \"nationality\": \"US\","
+            + "  \"address\": {"
+            + "    \"street\": \"123 Main St\","
+            + "    \"city\": \"Springfield\","
+            + "    \"zipCode\": \"12345\","
+            + "    \"country\": \"US\""
+            + "  }"
+            + "}"
+            + "}";
+
+    @LocalServerPort
+    int port;
+
+    @BeforeEach
+    void setUp() {
+        RestAssured.port = port;
+    }
+
+    @Test
+    void testStartApprovalProcessReturns201WithId() {
+        JsonPath result = given()
+                .contentType(ContentType.JSON)
+                .accept(ContentType.JSON)
+                .body(TRAVELLER_BODY)
+                .when()
+                .post("/approvals")
+                .then()
+                .statusCode(201)
+                .contentType(ContentType.JSON)
+                .body("id", notNullValue())
+                .extract()
+                .jsonPath();
+
+        assertThat(result.getString("id")).isNotBlank();
+        deleteApprovalInstance(result.getString("id"));
+    }
+
+    @Test
+    void testStartApprovalProcessResponseContainsTravellerData() {
+        JsonPath result = given()
+                .contentType(ContentType.JSON)
+                .accept(ContentType.JSON)
+                .body(TRAVELLER_BODY)
+                .when()
+                .post("/approvals")
+                .then()
+                .statusCode(201)
+                .extract()
+                .jsonPath();
+
+        String id = result.getString("id");
+        assertThat(result.getString("traveller.firstName")).isEqualTo("John");
+        assertThat(result.getString("traveller.lastName")).isEqualTo("Doe");
+        assertThat(result.getString("traveller.email")).isEqualTo("john.doe@example.com");
+        deleteApprovalInstance(id);
+    }
+
+    @Test
+    void testListApprovalsReturns200() {
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .get("/approvals")
+                .then()
+                .statusCode(200)
+                .contentType(ContentType.JSON);
+    }
+
+    @Test
+    void testListApprovalsReturnsArray() {
+        List<?> instances = given()
+                .accept(ContentType.JSON)
+                .when()
+                .get("/approvals")
+                .then()
+                .statusCode(200)
+                .extract()
+                .jsonPath()
+                .getList(".");
+
+        assertThat(instances).isNotNull();
+    }
+
+    @Test
+    void testGetApprovalsSchemaReturns200() {
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .get("/approvals/schema")
+                .then()
+                .statusCode(200)
+                .contentType(ContentType.JSON);
+    }
+
+    @Test
+    void testGetApprovalInstanceByIdReturns200() {
+        String id = startApprovalInstance();
+
+        try {
+            given()
+                    .accept(ContentType.JSON)
+                    .when()
+                    .get("/approvals/{id}", id)
+                    .then()
+                    .statusCode(200)
+                    .contentType(ContentType.JSON)
+                    .body("id", notNullValue());
+        } finally {
+            deleteApprovalInstance(id);
+        }
+    }
+
+    @Test
+    void testGetNonExistentApprovalReturns404() {
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .get("/approvals/{id}", "nonexistent-id-00000000-0000-0000-0000-000000000000")
+                .then()
+                .statusCode(404);
+    }
+
+    @Test
+    void testDeleteApprovalInstanceReturns200() {
+        String id = startApprovalInstance();
+
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .delete("/approvals/{id}", id)
+                .then()
+                .statusCode(200)
+                .contentType(ContentType.JSON);
+    }
+
+    @Test
+    void testDeleteApprovalInstanceMakesItUnavailable() {
+        String id = startApprovalInstance();
+
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .delete("/approvals/{id}", id)
+                .then()
+                .statusCode(200);
+
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .get("/approvals/{id}", id)
+                .then()
+                .statusCode(404);
+    }
+
+    @Test
+    void testUpdateApprovalInstanceReturns200() {
+        String id = startApprovalInstance();
+
+        try {
+            String updateBody = "{"
+                    + "\"traveller\": {"
+                    + "  \"firstName\": \"Jane\","
+                    + "  \"lastName\": \"Smith\","
+                    + "  \"email\": \"jane.smith@example.com\","
+                    + "  \"nationality\": \"UK\","
+                    + "  \"address\": {"
+                    + "    \"street\": \"456 Oak Ave\","
+                    + "    \"city\": \"London\","
+                    + "    \"zipCode\": \"EC1A 1BB\","
+                    + "    \"country\": \"UK\""
+                    + "  }"
+                    + "}"
+                    + "}";
+
+            given()
+                    .contentType(ContentType.JSON)
+                    .accept(ContentType.JSON)
+                    .body(updateBody)
+                    .when()
+                    .put("/approvals/{id}", id)
+                    .then()
+                    .statusCode(200)
+                    .contentType(ContentType.JSON);
+        } finally {
+            deleteApprovalInstance(id);
+        }
+    }
+
+    @Test
+    void testPatchApprovalInstanceReturns200() {
+        String id = startApprovalInstance();
+
+        try {
+            String patchBody = "{\"firstLineApproval\": false}";
+
+            given()
+                    .contentType(ContentType.JSON)
+                    .accept(ContentType.JSON)
+                    .body(patchBody)
+                    .when()
+                    .patch("/approvals/{id}", id)
+                    .then()
+                    .statusCode(200)
+                    .contentType(ContentType.JSON);
+        } finally {
+            deleteApprovalInstance(id);
+        }
+    }
+
+    @Test
+    void testGetTasksForApprovalInstance() {
+        String id = startApprovalInstance();
+
+        try {
+            List<?> tasks = given()
+                    .accept(ContentType.JSON)
+                    .queryParam("user", "manager")
+                    .queryParam("group", "managers")
+                    .when()
+                    .get("/approvals/{id}/tasks", id)
+                    .then()
+                    .statusCode(200)
+                    .contentType(ContentType.JSON)
+                    .extract()
+                    .jsonPath()
+                    .getList(".");
+
+            assertThat(tasks).isNotEmpty();
+        } finally {
+            deleteApprovalInstance(id);
+        }
+    }
+
+    @Test
+    void testGetFirstLineApprovalTaskDetails() {
+        String instanceId = startApprovalInstance();
+
+        try {
+            String taskId = getFirstTaskId(instanceId);
+
+            given()
+                    .accept(ContentType.JSON)
+                    .queryParam("user", "manager")
+                    .when()
+                    .get("/approvals/{id}/firstLineApproval/{taskId}", instanceId, taskId)
+                    .then()
+                    .statusCode(200)
+                    .contentType(ContentType.JSON)
+                    .body("id", notNullValue());
+        } finally {
+            deleteApprovalInstance(instanceId);
+        }
+    }
+
+    @Test
+    void testCompleteFirstLineApprovalTask() {
+        String instanceId = startApprovalInstance();
+
+        try {
+            String taskId = getFirstTaskId(instanceId);
+
+            String completeBody = "{\"approved\": true}";
+
+            given()
+                    .contentType(ContentType.JSON)
+                    .accept(ContentType.JSON)
+                    .queryParam("user", "manager")
+                    .queryParam("group", "managers")
+                    .body(completeBody)
+                    .when()
+                    .post("/approvals/{id}/firstLineApproval/{taskId}/phases/complete",
+                            instanceId, taskId)
+                    .then()
+                    .statusCode(200)
+                    .contentType(ContentType.JSON);
+        } finally {
+            deleteApprovalInstance(instanceId);
+        }
+    }
+
+    @Test
+    void testAfterFirstLineApprovalSecondLineTaskIsAvailable() {
+        String instanceId = startApprovalInstance();
+
+        try {
+            String firstTaskId = getFirstTaskId(instanceId);
+
+            given()
+                    .contentType(ContentType.JSON)
+                    .accept(ContentType.JSON)
+                    .queryParam("user", "manager")
+                    .queryParam("group", "managers")
+                    .body("{\"approved\": true}")
+                    .when()
+                    .post("/approvals/{id}/firstLineApproval/{taskId}/phases/complete",
+                            instanceId, firstTaskId)
+                    .then()
+                    .statusCode(200);
+
+            List<?> tasks = given()
+                    .accept(ContentType.JSON)
+                    .queryParam("user", "manager")
+                    .queryParam("group", "managers")
+                    .when()
+                    .get("/approvals/{id}/tasks", instanceId)
+                    .then()
+                    .statusCode(200)
+                    .extract()
+                    .jsonPath()
+                    .getList(".");
+
+            assertThat(tasks).isNotEmpty();
+        } finally {
+            deleteApprovalInstance(instanceId);
+        }
+    }
+
+    @Test
+    void testAbortFirstLineApprovalTask() {
+        String instanceId = startApprovalInstance();
+
+        try {
+            String taskId = getFirstTaskId(instanceId);
+
+            given()
+                    .contentType(ContentType.JSON)
+                    .accept(ContentType.JSON)
+                    .queryParam("user", "manager")
+                    .queryParam("group", "managers")
+                    .body("{}")
+                    .when()
+                    .post("/approvals/{id}/firstLineApproval/{taskId}/phases/abort",
+                            instanceId, taskId)
+                    .then()
+                    .statusCode(200);
+        } finally {
+            deleteApprovalInstance(instanceId);
+        }
+    }
+
+    @Test
+    void testManagementGetApprovalProcessInfo() {
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .get("/management/processes/approvals")
+                .then()
+                .statusCode(200)
+                .contentType(ContentType.JSON)
+                .body("id", notNullValue());
+    }
+
+    @Test
+    void testManagementGetApprovalProcessNodes() {
+        List<?> nodes = given()
+                .accept(ContentType.JSON)
+                .when()
+                .get("/management/processes/approvals/nodes")
+                .then()
+                .statusCode(200)
+                .contentType(ContentType.JSON)
+                .extract()
+                .jsonPath()
+                .getList(".");
+
+        assertThat(nodes).isNotEmpty();
+    }
+
+    private String startApprovalInstance() {
+        return given()
+                .contentType(ContentType.JSON)
+                .accept(ContentType.JSON)
+                .body(TRAVELLER_BODY)
+                .when()
+                .post("/approvals")
+                .then()
+                .statusCode(201)
+                .extract()
+                .path("id");
+    }
+
+    private String getFirstTaskId(String instanceId) {
+        return given()
+                .accept(ContentType.JSON)
+                .queryParam("user", "manager")
+                .queryParam("group", "managers")
+                .when()
+                .get("/approvals/{id}/tasks", instanceId)
+                .then()
+                .statusCode(200)
+                .extract()
+                .jsonPath()
+                .getString("[0].id");
+    }
+
+    private void deleteApprovalInstance(String id) {
+        given()
+                .accept(ContentType.JSON)
+                .when()
+                .delete("/approvals/{id}", id);
+    }
+}
