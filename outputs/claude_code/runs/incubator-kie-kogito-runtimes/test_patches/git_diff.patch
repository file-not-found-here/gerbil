+    }
+
+    @Test
+    void testGetSvgForApprovalsProcessReturnsSvgContentType() {
+        String contentType = given()
+                .when()
+                .get("/svg/processes/approvals")
+                .then()
+                .statusCode(200)
+                .extract()
+                .contentType();
