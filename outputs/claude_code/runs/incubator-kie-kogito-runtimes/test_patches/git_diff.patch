+                .accept(ContentType.JSON)
+                .when()
+                .get("/cinema/{id}", "nonexistent-00000000-0000-0000-0000-000000000000")
+                .then()
+                .statusCode(404);
+    }
+
+    @Test
+    void testDeleteCinemaInstanceReturns200() {
+        String id = startCinemaInstance();
+
+        given()
+                .accept(ContentType.JSON)
